    width: calc(100% + {{ section.settings.hero_padding_x_mobile | times: 2 }}px);
    margin-left: -{{ section.settings.hero_padding_x_mobile }}px;
    margin-right: -{{ section.settings.hero_padding_x_mobile }}px;
    padding: {{ section.settings.content_padding_mobile }}px {{ section.settings.hero_padding_x_mobile }}px;
    box-sizing: border-box;
    {% endif %}
  }

  #{{ section_id }} .herotest-hero__button-wrapper {
    margin-top: {{ hero_button_settings.settings.hero_button_margin_top_mobile }}px;
  }


  /* ------------------------------------------------------------------------
     TOP BAR WRAPPER — stacked: [logo row] -> [center text] -> [button row]
     Row padding replaces the topbar's own vertical padding on mobile.
     ------------------------------------------------------------------------ */

  #{{ section_id }} .herotest-topbar {
    position: relative;
    padding-top: 0; /* rows own their padding on mobile */
    padding-bottom: 0;
  }

  #{{ section_id }} .herotest-topbar__inner {
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
  }


  /* ------------------------------------------------------------------------
     ROW 1 — HAMBURGER (absolute left) + LOGO (true center)
     ------------------------------------------------------------------------ */

  #{{ section_id }} .herotest-topbar__left {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ topbar_settings.settings.mobile_logo_row_bg }};
    padding: 14px 55px; /* side padding reserves room for the hamburger */
    box-sizing: border-box;
  }

  #{{ section_id }} .herotest-topbar__close {
    position: absolute;
    left: 25px;
    top: 40%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: {{ topbar_settings.settings.top_text_color }};
    cursor: pointer;
    z-index: 5; /* low — Dawn's drawer must stay above */
    -webkit-tap-highlight-color: transparent;
  }

  #{{ section_id }} .herotest-logo {
    display: block;
    margin: 0;
    padding: 0;
  }

  #{{ section_id }} .herotest-logo__image {
    display: block;
    width: {{ topbar_settings.settings.logo_width_mobile }}px;
    max-width: 100%;
    height: auto;
  }


  /* ------------------------------------------------------------------------
     ROW 2 — CENTER TEXT
     ------------------------------------------------------------------------ */

  #{{ section_id }} .herotest-topbar__center {
    width: 100%;
    padding: 16px 15px 12px;
    box-sizing: border-box;
    text-align: center;
  }

  #{{ section_id }} .herotest-topbar__text {
    width: 100%;
    margin: 0;
    padding: 0;
    font-size: {{ topbar_settings.settings.top_text_size_mobile }}px;
    line-height: 1.4;
    white-space: normal;
    text-align: center;
  }


  /* ------------------------------------------------------------------------
     ROW 3 — BUTTON (single width rule, scoped)
     ------------------------------------------------------------------------ */

  #{{ section_id }} .herotest-topbar__right {
    width: 100%;
    padding: 0 15px {{ topbar_settings.settings.top_padding_y | times: 2 }}px;
    box-sizing: border-box;
  }

  #{{ section_id }} .herotest-button--top {
    width: {{ topbar_settings.settings.top_button_width_mobile }}%;
    min-width: 0;
    margin: 0 auto;
    padding:
      {{ topbar_settings.settings.top_button_padding_y_mobile }}px
      {{ topbar_settings.settings.top_button_padding_x_mobile }}px;
    font-size: {{ topbar_settings.settings.top_button_font_size_mobile }}px;
    box-sizing: border-box;
  }


  /* ------------------------------------------------------------------------
     MOBILE HERO
     ------------------------------------------------------------------------ */

  #{{ section_id }} .herotest-hero,
  #{{ section_id }} .herotest-hero__container {
    min-height: {{ section.settings.hero_min_height_mobile }}px;
  }

  #{{ section_id }} .herotest-hero__container {
