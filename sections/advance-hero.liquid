    min-height: {{ section.settings.hero_min_height_tablet }}px;
  }

  #{{ section_id }} .herotest-hero__container {
    padding:
      {{ section.settings.hero_padding_y_tablet }}px
      {{ section.settings.hero_padding_x_tablet }}px;
  }

  /* !important overrides the inline font-size set on the element. */
  #{{ section_id }} .herotest-hero__heading {
    font-size: {{ hero_content_settings.settings.heading_size_tablet }}px !important;
  }

  #{{ section_id }} .herotest-hero__description {
    font-size: {{ hero_content_settings.settings.paragraph_size_tablet }}px !important;
  }

}


/* ==========================================================================
   MOBILE — 750px and below
   ========================================================================== */

