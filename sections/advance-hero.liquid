  {% endcomment %}
  {% if section.settings.mobile_image != blank %}

    #{{ section_id }} .herotest-hero__background {
      background-image: url('{{ section.settings.mobile_image | image_url: width: 1800 | escape }}');
      background-position:
        {{ section.settings.mobile_image_position_x }}%
