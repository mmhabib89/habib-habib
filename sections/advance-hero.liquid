    transform: none;
  }

}

</style>


<script>
/* ==========================================================================
   MOBILE HAMBURGER -> DAWN NATIVE DRAWER WIRING
   ----------------------------------------------------------------------------
   The custom hamburger in the top bar drives Dawn's own <header-drawer>:
   - clicking it triggers the drawer's <summary>
   - a MutationObserver keeps the button's open/X state in sync
   - clicking anywhere outside the open drawer closes it
   If the theme header section is removed, header-drawer will not exist and
   the button stays inert — keep the header section in the template.
   ========================================================================== */
(() => {

  const section = document.getElementById('{{ section_id }}');
  if (!section) return;

  const customButton = section.querySelector('.herotest-topbar__close');
  if (!customButton) return;

  /* Resolve Dawn's header drawer element (may be null on pages without it). */
  const getHeaderDrawer = () => document.querySelector('header-drawer');

  /* Reflect the drawer's open state onto the hamburger button. */
  const updateButtonState = (isOpen) => {
    customButton.classList.toggle('is-open', isOpen);
    customButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    customButton.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  };

  /* Read the current open state from <details open> inside the drawer. */
  const getDrawerState = () => {
    const headerDrawer = getHeaderDrawer();
    if (!headerDrawer) return false;

    const details = headerDrawer.querySelector('details');
    if (!details) return false;

    return details.hasAttribute('open');
  };

  const syncButton = () => updateButtonState(getDrawerState());


  /* ---- CUSTOM BUTTON CLICK -> trigger Shopify's own summary ------------ */
  customButton.addEventListener('click', (event) => {

    event.preventDefault();
    event.stopPropagation();

    const headerDrawer = getHeaderDrawer();
    if (!headerDrawer) return;

    const shopifyMenuButton = headerDrawer.querySelector('summary');
    if (!shopifyMenuButton) return;

    shopifyMenuButton.click();

    /* Wait one tick for Shopify to toggle <details open>, then sync icon. */
    setTimeout(syncButton, 50);

  });


  /* ---- OBSERVE DRAWER STATE --------------------------------------------- */
  const observeShopifyDrawer = () => {

    const headerDrawer = getHeaderDrawer();
    if (!headerDrawer) return;

    const details = headerDrawer.querySelector('details');
    if (!details) return;

    new MutationObserver(syncButton).observe(details, {
      attributes: true,
      attributeFilter: ['open']
    });

  };


  /* ---- OUTSIDE CLICK CLOSES THE DRAWER ---------------------------------- */
  document.addEventListener('click', (event) => {

    const headerDrawer = getHeaderDrawer();
    if (!headerDrawer) return;

    const openDetails = headerDrawer.querySelector('details[open]');
    if (!openDetails) return;

    const drawer = openDetails.querySelector('.menu-drawer');
    if (!drawer) return;

    /* Click inside the drawer itself: ignore. */
    if (drawer.contains(event.target)) return;

    const shopifySummary = openDetails.querySelector('summary');

    /* Click on Shopify's own summary: let Shopify handle it. */
    if (shopifySummary && shopifySummary.contains(event.target)) return;

    if (shopifySummary) shopifySummary.click();

    updateButtonState(false);

  });


  /* Kick off on load: sync once, then keep watching for state changes. */
  syncButton();
  observeShopifyDrawer();

})();
</script>


