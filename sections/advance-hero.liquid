    }

  {% endif %}

  #{{ section_id }} .herotest-hero__heading {
    font-size: {{ hero_content_settings.settings.heading_size_mobile }}px !important;
  }

  #{{ section_id }} .herotest-hero__description {
    font-size: {{ hero_content_settings.settings.paragraph_size_mobile }}px !important;
