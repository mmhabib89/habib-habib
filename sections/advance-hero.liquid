{% comment %}
  ============================================================================
  ADVANCE HERO (Herotest) — Shopify OS 2.0 hero section
  ----------------------------------------------------------------------------
  Full-configurable hero with an integrated announcement-style top bar,
  overlay, two CTA buttons, and a bottom text bar.

  FIXED IN THIS VERSION:
  - Mobile top bar rebuilt: hamburger absolute-left, logo true-center,
    center text row, full-width button row
  - Removed unscoped global CSS (.herotest-button--top 80%,
    .menu-drawer__navigation padding) that leaked outside the section
  - Removed header-drawer z-index overrides that fought Dawn's own stacking
  - Desktop grid columns hardened with minmax(0, 1fr)
  - Mobile background image override simplified (no redundant !important block)
  - Mobile content vertical position now configurable (top/center/bottom)
  - Mobile text+button background now a toggleable color + padding setting
    instead of hardcoded white per element
  ============================================================================
{% endcomment %}

{% liquid
  # ---------------------------------------------------------------------------
  # SECTION-WIDE VARIABLES
  # ---------------------------------------------------------------------------

  # Unique element id per section instance. Every scoped CSS rule and the
  # script at the bottom target this id so multiple instances never clash.
  assign section_id = 'herotest-' | append: section.id

  assign topbar_settings = section.blocks | where: 'type', 'top_bar' | first
  assign hero_content_settings = section.blocks | where: 'type', 'hero_content' | first
  assign hero_button_settings = section.blocks | where: 'type', 'hero_button' | first
  assign bottom_bar_settings = section.blocks | where: 'type', 'bottom_bar' | first

  # Map the "Content vertical position - Mobile" setting to the CSS
  # justify-content value used on the hero content block. The result is
  # injected through the --ht-mobile-content-justify custom property.
  case section.settings.mobile_content_position
    when 'center'
      assign mobile_content_justify = 'center'
    when 'bottom'
      assign mobile_content_justify = 'flex-end'
    else
      # 'top' (and any unknown value) defaults to flex-start.
      assign mobile_content_justify = 'flex-start'
  endcase
%}

<section
  id="{{ section_id }}"
  class="herotest-section"
  style="--ht-button-motion-duration: {{ hero_button_settings.settings.button_animation_duration }}ms;"
>

  {% comment %}
    ==========================================================================
    1. TOP BAR
    ==========================================================================
    Optional announcement strip rendered above the hero photo.

    Desktop layout (CSS grid, three columns):
      [ hamburger + logo ]   [ center text ]   [ button ]

    Mobile layout (CSS flex, stacked):
      Row 1 - hamburger (absolute left) + logo (true center)
      Row 2 - center text
      Row 3 - full-width button
  {% endcomment %}
  {% if topbar_settings.settings.show_top_bar %}

    <div
      class="herotest-topbar"
      {{ topbar_settings.shopify_attributes }}
      style="
        --ht-top-bg: {{ topbar_settings.settings.top_bg }};
        --ht-top-text-color: {{ topbar_settings.settings.top_text_color }};
        --ht-top-padding-y: {{ topbar_settings.settings.top_padding_y }}px;
      "
    >

      <div class="herotest-topbar__inner">

        {% comment %}
          1.1 LEFT COLUMN — hamburger (mobile only) + logo
        {% endcomment %}
        <div class="herotest-topbar__left">

          {% comment %}
            Custom hamburger button. On click it programmatically triggers
            Dawn's native <header-drawer> (see the script at the bottom of
            this file). Kept hidden on desktop via CSS.
          {% endcomment %}
          <button
            type="button"
            class="herotest-topbar__close"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <span class="herotest-menu-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>

          {% comment %}
            Logo wrapper. Split across conditionals so the same inner markup
            (image or shop-name fallback) is shared by both branches:
              - with a link  -> <a href="...">
              - without link -> plain <div>
          {% endcomment %}
          {% if topbar_settings.settings.show_logo %}

            {% if topbar_settings.settings.logo_link != blank %}
              <a
                href="{{ topbar_settings.settings.logo_link }}"
                class="herotest-logo"
                aria-label="{{ shop.name | escape }}"
              >
            {% else %}
              <div class="herotest-logo">
            {% endif %}

              {% if topbar_settings.settings.logo != blank %}
                {{ topbar_settings.settings.logo | image_url: width: 600 | image_tag: class: 'herotest-logo__image', widths: '100,150,200,300,400,600', loading: 'eager', alt: shop.name }}
              {% else %}
                <span class="herotest-logo__text">{{ shop.name }}</span>
              {% endif %}

            {% if topbar_settings.settings.logo_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}

          {% endif %}

        </div>

        {% comment %}
          1.2 CENTER COLUMN — announcement / promo text
        {% endcomment %}
        <div class="herotest-topbar__center">

          {% if topbar_settings.settings.show_top_text and topbar_settings.settings.top_text != blank %}
            <div
              class="herotest-topbar__text"
              style="color: {{ topbar_settings.settings.top_text_color }};"
            >
              {{ topbar_settings.settings.top_text }}
            </div>
          {% endif %}

        </div>

        {% comment %}
          1.3 RIGHT COLUMN — top bar button
          When no link is configured the anchor falls back to "#" and is
          marked aria-disabled so it stays non-navigational.
        {% endcomment %}
        <div class="herotest-topbar__right">

          {% if topbar_settings.settings.show_top_button and topbar_settings.settings.top_button_text != blank %}

            <a
              href="{{ topbar_settings.settings.top_button_link | default: '#' }}"
              {% if topbar_settings.settings.top_button_link == blank %}
                aria-disabled="true"
              {% endif %}
              class="herotest-button herotest-button--top herotest-button--fill-{{ topbar_settings.settings.top_button_animation }}"
              style="
                --ht-top-button-bg: {{ topbar_settings.settings.top_button_bg }};
                --ht-top-button-color: {{ topbar_settings.settings.top_button_text_color }};
                --ht-button-hover-bg: {{ topbar_settings.settings.top_button_hover_bg }};
                --ht-button-hover-color: {{ topbar_settings.settings.top_button_hover_text_color }};
              "
            >

            <span class="herotest-button__text">
              {{ topbar_settings.settings.top_button_text }}
            </span>

            {% if topbar_settings.settings.show_top_button_arrow %}
              <span class="herotest-button__arrow" aria-hidden="true">
                <svg viewBox="0 0 32 16" focusable="false">
                  <path d="M1 8h29m-7-7 7 7-7 7" />
                </svg>
              </span>
            {% endif %}

          </a>

          {% endif %}

        </div>

      </div>

    </div>

  {% endif %}

  {% comment %}
    ==========================================================================
    2. HERO
    ==========================================================================
    Background photo + optional overlay + content column + CTA.
  {% endcomment %}

  <div
    class="herotest-hero"
    style="
      --ht-hero-height: {{ section.settings.hero_min_height }}px;
      --ht-mobile-content-justify: {{ mobile_content_justify }};
    "
  >

    {% comment %}
      2.1 BACKGROUND
      The image URL is stored as a CSS custom property (--ht-desktop-bg-image)
      so the mobile media query can swap in the mobile image without touching
      the HTML. Declared via an if/else because a blank image_picker outputs
      literal "url('')", which breaks the whole background rule.
    {% endcomment %}
    <div
      class="herotest-hero__background"
      {% if section.settings.desktop_image != blank %}
        style="
          --ht-desktop-bg-image: url('{{ section.settings.desktop_image | image_url: width: 3000 | escape }}');
          --ht-desktop-bg-position-x: {{ section.settings.desktop_image_position_x }}%;
          --ht-desktop-bg-position-y: {{ section.settings.desktop_image_position_y }}%;
        "
      {% else %}
        style="
          --ht-desktop-bg-image: none;
          --ht-desktop-bg-position-x: 50%;
          --ht-desktop-bg-position-y: 50%;
        "
      {% endif %}
      aria-hidden="true"
    ></div>

    {% comment %}
      2.2 OVERLAY — optional darkening layer between photo and content.
      Opacity is converted from the 0-100 (%) setting to a 0-1 CSS value
      using a float division (see divided_by: 100.0).
    {% endcomment %}
    {% if section.settings.enable_overlay %}
      <div
        class="herotest-hero__overlay"
        aria-hidden="true"
        style="
          --ht-overlay-color: {{ section.settings.overlay_color }};
          --ht-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
        "
      ></div>
    {% endif %}

    {% comment %}
      2.3 CONTENT CONTAINER — centered max-width wrapper. Vertical alignment
      of the inner content column is handled per-breakpoint (desktop via
      content_vertical, mobile via mobile_content_position).
    {% endcomment %}
    <div class="herotest-hero__container">

      <div
        class="
          herotest-hero__content
          herotest-hero__content--position-{{ section.settings.content_position }}
        "
        style="max-width: {{ section.settings.content_max_width }}px;"
      >

        <div
          class="herotest-hero__content-inner{% if hero_content_settings.settings.content_background_enabled %} herotest-hero__content-inner--background{% endif %}{% if hero_content_settings.settings.use_content_text_color %} herotest-hero__content-inner--custom-text-color{% endif %}"
          {{ hero_content_settings.shopify_attributes }}
          style="
            --ht-content-background: {{ hero_content_settings.settings.content_background_color }};
            --ht-content-text-color: {{ hero_content_settings.settings.content_text_color }};
            --ht-content-padding-x: {{ hero_content_settings.settings.content_padding_x }}px;
            --ht-content-padding-y: {{ hero_content_settings.settings.content_padding_y }}px;
          "
        >

          {% comment %}
            2.3.1 HERO HEADING
          {% endcomment %}
          {% if hero_content_settings.settings.show_heading and hero_content_settings.settings.heading != blank %}
            <h1
              class="herotest-hero__heading"
              style="
                color: {{ hero_content_settings.settings.heading_color }};
                font-size: {{ hero_content_settings.settings.heading_size_desktop }}px;
              "
            >
              {{ hero_content_settings.settings.heading }}
            </h1>
          {% endif %}

          {% comment %}
            2.3.2 HERO PARAGRAPH — newline_to_br renders textarea line breaks
            as <br> tags for multi-line copy.
          {% endcomment %}
          {% if hero_content_settings.settings.show_paragraph and hero_content_settings.settings.paragraph != blank %}
            <div
              class="herotest-hero__description"
              style="
                color: {{ hero_content_settings.settings.paragraph_color }};
                font-size: {{ hero_content_settings.settings.paragraph_size_desktop }}px;
              "
            >
              {{ hero_content_settings.settings.paragraph | newline_to_br }}
            </div>
          {% endif %}

          {% comment %}
            2.3.3 HERO BUTTON — same "#" + aria-disabled fallback pattern as
            the top bar button when no link is set.
          {% endcomment %}
          {% if hero_button_settings.settings.show_hero_button and hero_button_settings.settings.hero_button_text != blank %}

            <div
              class="herotest-hero__button-wrapper"
              {{ hero_button_settings.shopify_attributes }}
            >

              <a
                href="{{ hero_button_settings.settings.hero_button_link | default: '#' }}"
                {% if hero_button_settings.settings.hero_button_link == blank %}
                  aria-disabled="true"
                {% endif %}
                class="herotest-button herotest-button--hero herotest-button--fill-{{ hero_button_settings.settings.hero_button_animation }}"
                style="
                  --ht-hero-button-bg: {{ hero_button_settings.settings.hero_button_bg }};
                  --ht-hero-button-color: {{ hero_button_settings.settings.hero_button_text_color }};
                  --ht-button-hover-bg: {{ hero_button_settings.settings.hero_button_hover_bg }};
                  --ht-button-hover-color: {{ hero_button_settings.settings.hero_button_hover_text_color }};
                "
              >

              <span class="herotest-button__text">
                {{ hero_button_settings.settings.hero_button_text }}
              </span>

              {% if hero_button_settings.settings.show_hero_button_arrow %}
                <span class="herotest-button__arrow" aria-hidden="true">
                  <svg viewBox="0 0 32 16" focusable="false">
                    <path d="M1 8h29m-7-7 7 7-7 7" />
                  </svg>
                </span>
              {% endif %}

            </a>

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  </div>

  {% comment %}
    ==========================================================================
    3. BOTTOM TEXT BAR
    ==========================================================================
    Optional slim strip under the hero photo (centered, full-width).
  {% endcomment %}
  {% if bottom_bar_settings.settings.show_bottom_bar %}

    <div
      class="herotest-bottom"
      {{ bottom_bar_settings.shopify_attributes }}
      style="
        background-color: {{ bottom_bar_settings.settings.bottom_bg }};
        color: {{ bottom_bar_settings.settings.bottom_text_color }};
        padding-top: {{ bottom_bar_settings.settings.bottom_padding_y }}px;
        padding-bottom: {{ bottom_bar_settings.settings.bottom_padding_y }}px;
      "
    >

      {% if bottom_bar_settings.settings.bottom_text != blank %}
        <div
          class="herotest-bottom__text"
          style="color: {{ bottom_bar_settings.settings.bottom_text_color }};"
        >
          {{ bottom_bar_settings.settings.bottom_text }}
        </div>
      {% endif %}

    </div>

  {% endif %}

</section>


<style>
/* ==========================================================================
   GLOBAL — section wrapper
   ========================================================================== */

#{{ section_id }} {
  width: 100%;
  display: block;
  position: relative;
  overflow: hidden;
}


/* ==========================================================================
   TOP BAR
   ========================================================================== */

#{{ section_id }} .herotest-topbar {
  width: 100%;
  position: relative;
  background: var(--ht-top-bg);
  padding-top: var(--ht-top-padding-y);
  padding-bottom: var(--ht-top-padding-y);
}

/* Three-column grid: left (logo) / center (text) / right (button).
   minmax(0, 1fr) on the outer columns stops long text or a wide logo from
   pushing the center column off-axis. */
#{{ section_id }} .herotest-topbar__inner {
  width: 100%;
  max-width: {{ topbar_settings.settings.topbar_max_width }}px;
  margin: 0 auto;
  padding-left: {{ topbar_settings.settings.topbar_side_padding }}px;
  padding-right: {{ topbar_settings.settings.topbar_side_padding }}px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 20px;
  box-sizing: border-box;
}


/* ---------------------------------------------------------------------------
   TOP BAR - LEFT COLUMN / LOGO
   --------------------------------------------------------------------------- */

#{{ section_id }} .herotest-topbar__left {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: relative;
}

#{{ section_id }} .herotest-logo {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  color: var(--ht-top-text-color);
  max-width: 100%;
}

#{{ section_id }} .herotest-logo__image {
  display: block;
  width: {{ topbar_settings.settings.logo_width }}px;
  max-width: 100%;
  height: auto;
}

/* Fallback text logo used when no image is uploaded. */
#{{ section_id }} .herotest-logo__text {
  color: var(--ht-top-text-color);
  font-size: {{ topbar_settings.settings.logo_text_size }}px;
  font-weight: {{ topbar_settings.settings.logo_font_weight }};
  letter-spacing: {{ topbar_settings.settings.logo_letter_spacing }}px;
  line-height: 1;
}


/* ---------------------------------------------------------------------------
   TOP BAR - MOBILE MENU BUTTON
   Hidden above the mobile breakpoint; shown (absolute) only on mobile.
   --------------------------------------------------------------------------- */

#{{ section_id }} .herotest-topbar__close {
  display: none;
}

/* Three-bar hamburger icon. */
#{{ section_id }} .herotest-menu-icon {
  width: 22px;
  height: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

#{{ section_id }} .herotest-menu-icon span {
  display: block;
  width: 100%;
  height: 2px;
  background: currentColor;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

/* Animate the three bars into an "X" when the drawer is open
   (class is toggled from the script). */
#{{ section_id }} .herotest-topbar__close.is-open .herotest-menu-icon span:nth-child(1) {
  transform: translateY(8px) rotate(45deg);
}

#{{ section_id }} .herotest-topbar__close.is-open .herotest-menu-icon span:nth-child(2) {
  opacity: 0;
}

#{{ section_id }} .herotest-topbar__close.is-open .herotest-menu-icon span:nth-child(3) {
  transform: translateY(-8px) rotate(-45deg);
}


/* ---------------------------------------------------------------------------
   TOP BAR - CENTER TEXT
   --------------------------------------------------------------------------- */

#{{ section_id }} .herotest-topbar__center {
  min-width: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

#{{ section_id }} .herotest-topbar__text {
  font-size: {{ topbar_settings.settings.top_text_size }}px;
  line-height: 1.4;
  white-space: nowrap;
}


/* ---------------------------------------------------------------------------
   TOP BAR - RIGHT BUTTON COLUMN
   --------------------------------------------------------------------------- */

#{{ section_id }} .herotest-topbar__right {
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}


/* ---------------------------------------------------------------------------
   BUTTON BASE — shared by the top bar button and the hero button
   --------------------------------------------------------------------------- */

#{{ section_id }} .herotest-button {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: {{ hero_button_settings.settings.button_arrow_gap }}px;
  text-decoration: none;
  cursor: pointer;
  border: 0;
  border-radius: {{ hero_button_settings.settings.button_radius }}px;
  transition: color 0.3s ease, transform 0.3s ease, background-color 0.3s ease;
  -webkit-tap-highlight-color: transparent;
}

/* Keep the animated fill behind the label and arrow so neither shifts. */
#{{ section_id }} .herotest-button::before {
  position: absolute;
  z-index: 0;
  inset: 0;
  background: var(--ht-button-hover-bg);
  content: '';
  pointer-events: none;
  transition: transform var(--ht-button-motion-duration) cubic-bezier(0.22, 1, 0.36, 1);
}

#{{ section_id }} .herotest-button > span {
  position: relative;
  z-index: 1;
}

#{{ section_id }} .herotest-button--fill-none::before {
  content: none;
}

#{{ section_id }} .herotest-button--fill-left-to-right::before {
  transform: scaleX(0);
  transform-origin: left center;
}

#{{ section_id }} .herotest-button--fill-right-to-left::before {
  transform: scaleX(0);
  transform-origin: right center;
}

#{{ section_id }} .herotest-button--fill-bottom-to-top::before {
  transform: scaleY(0);
  transform-origin: center bottom;
}

#{{ section_id }} .herotest-button--fill-top-to-bottom::before {
  transform: scaleY(0);
  transform-origin: center top;
}

#{{ section_id }} .herotest-button--fill-left-to-right:hover::before,
#{{ section_id }} .herotest-button--fill-left-to-right:focus-visible::before,
#{{ section_id }} .herotest-button--fill-right-to-left:hover::before,
#{{ section_id }} .herotest-button--fill-right-to-left:focus-visible::before {
  transform: scaleX(1);
}

#{{ section_id }} .herotest-button--fill-bottom-to-top:hover::before,
#{{ section_id }} .herotest-button--fill-bottom-to-top:focus-visible::before,
#{{ section_id }} .herotest-button--fill-top-to-bottom:hover::before,
#{{ section_id }} .herotest-button--fill-top-to-bottom:focus-visible::before {
  transform: scaleY(1);
}

#{{ section_id }} .herotest-button--fill-none:hover {
  background-color: var(--ht-button-hover-bg);
}

#{{ section_id }} .herotest-button:hover {
  transform: translateY(-2px);
}

#{{ section_id }} .herotest-button:active {
  transform: translateY(0);
}

#{{ section_id }} .herotest-button:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

/* Trailing arrow, pushed further right on hover/focus. */
#{{ section_id }} .herotest-button__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  line-height: 1;
  transition: transform 0.35s ease;
}

#{{ section_id }} .herotest-button__arrow svg {
  display: block;
  width: 100%;
  height: 16px;
  overflow: visible;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.5;
}

#{{ section_id }} .herotest-button:hover .herotest-button__arrow,
#{{ section_id }} .herotest-button:focus-visible .herotest-button__arrow {
  transform: translateX({{ hero_button_settings.settings.arrow_hover_distance }}px);
}

/* Top bar button variant. Colors are injected via CSS custom properties. */
#{{ section_id }} .herotest-button--top {
  min-width: {{ topbar_settings.settings.top_button_min_width }}px;
  padding:
    {{ topbar_settings.settings.top_button_padding_y }}px
    {{ topbar_settings.settings.top_button_padding_x }}px;
  background-color: var(--ht-top-button-bg);
  color: var(--ht-top-button-color);
  font-size: {{ topbar_settings.settings.top_button_font_size }}px;
  text-align: center;
}

#{{ section_id }} .herotest-button--top:hover {
  color: var(--ht-button-hover-color);
}


/* ==========================================================================
   HERO
   ========================================================================== */

#{{ section_id }} .herotest-hero {
  position: relative;
  width: 100%;
  min-height: var(--ht-hero-height);
  isolation: isolate;
  overflow: hidden;
}

/* Background photo. Uses the CSS custom property set inline in the markup so
   the mobile query can swap images without duplicating declarations. */
#{{ section_id }} .herotest-hero__background {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
  background-color: #f5f5f5; /* fallback while the image loads / if blank */
  background-image: var(--ht-desktop-bg-image);
  background-position: var(--ht-desktop-bg-position-x) var(--ht-desktop-bg-position-y);
  background-repeat: no-repeat;
  background-size: cover;
  pointer-events: none; /* never blocks clicks on the content above it */
}

/* Darkening overlay between photo and content. */
#{{ section_id }} .herotest-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
  background-color: var(--ht-overlay-color);
  opacity: var(--ht-overlay-opacity);
  pointer-events: none;
}

/* ==========================================================================
   HERO CONTENT CONTAINER
   ========================================================================== */

/* Max-width wrapper; flex so the aligned content column can grow inside it. */
#{{ section_id }} .herotest-hero__container {
  position: relative;
  z-index: 2; /* above background (0) and overlay (1) */
  width: 100%;
  max-width: {{ section.settings.hero_max_width }}px;
  min-height: var(--ht-hero-height);
  margin: 0 auto;
  padding:
    {{ section.settings.hero_padding_y }}px
    {{ section.settings.hero_padding_x }}px;
  display: flex;
  box-sizing: border-box;
}

#{{ section_id }} .herotest-hero__content {
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}


/* ==========================================================================
   CONTENT POSITION
   ========================================================================== */

#{{ section_id }} .herotest-hero__content--position-top-left,
#{{ section_id }} .herotest-hero__content--position-middle-left,
#{{ section_id }} .herotest-hero__content--position-bottom-left {
  align-items: flex-start;
  text-align: left;
}

#{{ section_id }} .herotest-hero__content--position-top-center,
#{{ section_id }} .herotest-hero__content--position-middle-center,
#{{ section_id }} .herotest-hero__content--position-bottom-center {
  align-items: center;
  text-align: center;
}

#{{ section_id }} .herotest-hero__content--position-top-right,
#{{ section_id }} .herotest-hero__content--position-middle-right,
#{{ section_id }} .herotest-hero__content--position-bottom-right {
  align-items: flex-end;
  text-align: right;
}

#{{ section_id }} .herotest-hero__content--position-top-left,
#{{ section_id }} .herotest-hero__content--position-top-center,
#{{ section_id }} .herotest-hero__content--position-top-right {
  justify-content: flex-start;
}

#{{ section_id }} .herotest-hero__content--position-middle-left,
