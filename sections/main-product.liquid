{% render 'section-margin', margin_top: section.settings.margin_top, margin_bottom: section.settings.margin_bottom %}
{{ 'product.css' | asset_url | stylesheet_tag }}
{%- comment -%} Meridian — main-product.liquid —  Full build Phase 3 {%- endcomment -%}
{%- assign pdp_price_hidden = false -%}
{%- if settings.hide_price_until_login and customer == nil -%}
  {%- assign pdp_price_hidden = true -%}
{%- endif -%}
{%- assign is_preorder = false -%}
{%- if settings.preorder_enabled -%}
  {%- assign preorder_tag_down = settings.preorder_tag | downcase -%}
  {%- for tag in product.tags -%}
    {%- assign tag_down = tag | downcase -%}
    {%- if tag_down == preorder_tag_down -%}
      {%- assign is_preorder = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<div class="pdp-shell color-{{ section.settings.color_scheme | default: 'scheme-1' }}">
  <div
    class="page-width pdp-shell__content"
    style="--pdp-padding-top: {{ section.settings.padding_top | default: 48 }}px; --pdp-padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;"
  >
    {%- render 'breadcrumbs', class: 'pdp-breadcrumb' -%}
    {%- assign pdp_layout = settings.product_detail_layout | default: 'classic' -%}
    {%- if pdp_layout == 'editorial' -%}
      {%- render 'product-detail-editorial', pdp_price_hidden: pdp_price_hidden, is_preorder: is_preorder -%}
    {%- elsif pdp_layout == 'split_dark' -%}
      {%- render 'product-detail-split', pdp_price_hidden: pdp_price_hidden, is_preorder: is_preorder -%}
    {%- else -%}
    <div class="pdp-layout">
      <!-- Media -->
      <div{% if settings.product_media_position == 'right' %} class="pdp-order-2"{% endif %}>
        {%- assign gallery_layout = settings.product_gallery_layout | default: 'stacked' -%}
        {%- if gallery_layout == 'grid' -%}
          <div class="pdp-gallery-grid">
            {%- for media in product.media -%}
              <div class="pdp-media-wrap">
                {%- assign media_loading = 'lazy' -%}
                {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- endif -%}
                {%- render 'product-media', media: media, ratio_class: 'ratio-1x1', img_width: 700, img_height: 700, loading: media_loading -%}
              </div>
            {%- else -%}
              <div class="full-width ratio-1x1 ph-tile"></div>
            {%- endfor -%}
          </div>
        {%- elsif gallery_layout == 'thumbnails' -%}
          {%- assign thumb_pos = settings.product_thumbnail_position | default: 'bottom' -%}
          <div class="pdp-thumbs-layout pdp-thumbs-layout--{{ thumb_pos }}">
            {%- if thumb_pos == 'left' or thumb_pos == 'top' -%}
              {%- if product.images.size > 1 -%}
                {%- comment -%}
                  Driven by assets/product-gallery.js, same as the thumb rails in
                  media-gallery.liquid. These were hover-only images before, which
                  left the gallery unusable on touch and unreachable by keyboard.
                {%- endcomment -%}
                <div class="pdp-thumbs-scroll{% if product.images.size <= 5 %} pdp-thumbs-scroll--no-arrows{% endif %}{% if thumb_pos == 'left' %} pdp-thumbs-scroll--vertical{% endif %}" data-thumb-scroll>
                  {%- if product.images.size > 5 -%}
                  <button type="button" class="thumb-arrow thumb-arrow--{{ settings.thumbnail_arrow_style | default: 'circle' }}" data-thumb-prev aria-label="{{ 'general.slideshow.previous' | t }}" disabled style="{% if settings.thumbnail_arrow_style == 'solid' and settings.thumbnail_arrow_bg != blank %}--thumb-arrow-bg:{{ settings.thumbnail_arrow_bg }};{% endif %}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                  {%- endif -%}
                  <div class="pdp-thumbs" data-gallery data-main-image="main-product-img">
                    {%- for image in product.images -%}
                      <button
                        type="button"
                        class="pdp-thumb-btn{% if forloop.first %} active{% endif %}"
                        data-media-index="{{ forloop.index0 }}"
                        data-media-src="{{ image | image_url: width: 900 }}"
                        aria-label="{{ 'products.product.media.view_media' | t: index: forloop.index }}"
                      >
                        <img src="{{ image | image_url: width: 200 }}" srcset="{{ image | image_url: width: 200 }} 200w,
                        {{ image | image_url: width: 400 }} 400w" sizes="200px" alt="{{ image.alt | escape }}" class="pdp-thumb" loading="lazy" width="200" height="200">
                      </button>
                    {%- endfor -%}
                  </div>
                  {%- if product.images.size > 5 -%}
                  <button type="button" class="thumb-arrow thumb-arrow--{{ settings.thumbnail_arrow_style | default: 'circle' }}" data-thumb-next aria-label="{{ 'general.slideshow.next' | t }}" style="{% if settings.thumbnail_arrow_style == 'solid' and settings.thumbnail_arrow_bg != blank %}--thumb-arrow-bg:{{ settings.thumbnail_arrow_bg }};{% endif %}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
            <div class="pdp-thumbs-layout__main pdp-media-wrap--stacked pdp-media-nav" data-media-nav data-main-image="main-product-img">
              <img src="{{ product.featured_image | image_url: width: 900 }}" srcset="{{ product.featured_image | image_url: width: 675 }} 675w,
                      {{ product.featured_image | image_url: width: 900 }} 900w,
                      {{ product.featured_image | image_url: width: 1350 }} 1350w" sizes="(max-width:749px) 100vw, (max-width:989px) 92vw, 50vw" alt="{{ product.featured_image.alt | escape }}" id="main-product-img" class="pdp-zoom-img img-cover ratio-4x5{% if settings.product_enable_image_zoom %} pdp-zoomable{% endif %}" style="object-position: {{ product.featured_image.presentation.focal_point | default: 'center' }};" loading="eager" width="900" height="1125">
              {%- if product.images.size > 1 -%}
              <button type="button" class="thumb-arrow thumb-arrow--{{ settings.thumbnail_arrow_style | default: 'circle' }} pdp-nav-arrow pdp-nav-arrow--prev" data-media-prev aria-label="{{ 'general.slideshow.previous' | t }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
              <button type="button" class="thumb-arrow thumb-arrow--{{ settings.thumbnail_arrow_style | default: 'circle' }} pdp-nav-arrow pdp-nav-arrow--next" data-media-next aria-label="{{ 'general.slideshow.next' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
              {%- endif -%}
            </div>
            {%- if thumb_pos == 'right' or thumb_pos == 'bottom' -%}
              {%- if product.images.size > 1 -%}
                <div class="pdp-thumbs-scroll{% if product.images.size <= 5 %} pdp-thumbs-scroll--no-arrows{% endif %}{% if thumb_pos == 'right' %} pdp-thumbs-scroll--vertical{% endif %}" data-thumb-scroll>
                  {%- if product.images.size > 5 -%}
                  <button type="button" class="thumb-arrow thumb-arrow--{{ settings.thumbnail_arrow_style | default: 'circle' }}" data-thumb-prev aria-label="{{ 'general.slideshow.previous' | t }}" disabled style="{% if settings.thumbnail_arrow_style == 'solid' and settings.thumbnail_arrow_bg != blank %}--thumb-arrow-bg:{{ settings.thumbnail_arrow_bg }};{% endif %}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                  {%- endif -%}
                  <div class="pdp-thumbs" data-gallery data-main-image="main-product-img">
                    {%- for image in product.images -%}
                      <button
                        type="button"
                        class="pdp-thumb-btn{% if forloop.first %} active{% endif %}"
                        data-media-index="{{ forloop.index0 }}"
                        data-media-src="{{ image | image_url: width: 900 }}"
                        aria-label="{{ 'products.product.media.view_media' | t: index: forloop.index }}"
                      >
                        <img src="{{ image | image_url: width: 200 }}" srcset="{{ image | image_url: width: 200 }} 200w,
                        {{ image | image_url: width: 400 }} 400w" sizes="200px" alt="{{ image.alt | escape }}" class="pdp-thumb" loading="lazy" width="200" height="200">
                      </button>
                    {%- endfor -%}
                  </div>
                  {%- if product.images.size > 5 -%}
                  <button type="button" class="thumb-arrow thumb-arrow--{{ settings.thumbnail_arrow_style | default: 'circle' }}" data-thumb-next aria-label="{{ 'general.slideshow.next' | t }}" style="{% if settings.thumbnail_arrow_style == 'solid' and settings.thumbnail_arrow_bg != blank %}--thumb-arrow-bg:{{ settings.thumbnail_arrow_bg }};{% endif %}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
          {%- for media in product.media -%}
            {%- unless media.media_type == 'image' -%}
              <div class="pdp-media-wrap--stacked">
                {%- render 'product-media', media: media, ratio_class: 'ratio-4x5', img_width: 900, img_height: 1125, loading: 'lazy' -%}
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} stacked (default) {%- endcomment -%}
          {%- for media in product.media -%}
            <div class="pdp-media-wrap--stacked">
              {%- assign media_loading = 'lazy' -%}
              {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- endif -%}
              {%- render 'product-media', media: media, ratio_class: 'ratio-4x5', img_width: 900, img_height: 1125, loading: media_loading -%}
            </div>
          {%- else -%}
            <div class="full-width ratio-4x5 ph-tile"></div>
          {%- endfor -%}
        {%- endif -%}
        {%- assign model_media = product.media | where: 'media_type', 'model' -%}
        {%- if model_media.size > 0 -%}
          <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css">
          <script>
            (function() {
              function initModelViewer() {
                if (!window.Shopify || !Shopify.loadFeatures) return;
                Shopify.loadFeatures([{
                  name: 'model-viewer-ui',
                  version: '1.0',
                  onLoad: function() {
                    document.querySelectorAll('.pdp-media-model model-viewer').forEach(function(mv) {
                      if (!mv.dataset.uiInitialized) {
                        new Shopify.ModelViewerUI(mv);
                        mv.dataset.uiInitialized = 'true';
                      }
                    });
                  }
                }]);
              }
              var models = document.querySelectorAll('.pdp-media-model model-viewer');
              if (!models.length) return;
              if (!('IntersectionObserver' in window)) {
                initModelViewer();
                return;
              }
              var observer = new IntersectionObserver(function(entries) {
                if (entries.some(function(entry) { return entry.isIntersecting; })) {
                  observer.disconnect();
                  initModelViewer();
                }
              }, { rootMargin: '200px' });
              models.forEach(function(model) { observer.observe(model); });
            })();
          </script>
        {%- endif -%}
      </div>
      <!-- Info -->
      <div class="pdp-info{% if settings.product_media_position == 'right' %} pdp-order-1{% endif %}">
        {%- render 'product-info-blocks', pdp_price_hidden: pdp_price_hidden, is_preorder: is_preorder -%}
      </div>
    </div>
    {%- endif -%}
  </div>
</div>

{%- if settings.product_enable_image_zoom -%}
  <div id="pdp-zoom-overlay" class="pdp-zoom-overlay" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ 'products.product.media.view_media' | t: index: 1 }}">
    <button type="button" id="pdp-zoom-close" class="pdp-zoom-close" aria-label="{{ 'accessibility.close' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button type="button" id="pdp-zoom-prev" class="pdp-zoom-arrow pdp-zoom-arrow--prev" aria-label="{{ 'general.slideshow.previous' | t }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" id="pdp-zoom-next" class="pdp-zoom-arrow pdp-zoom-arrow--next" aria-label="{{ 'general.slideshow.next' | t }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <img id="pdp-zoom-img-large" alt="" aria-hidden="true" width="1800" height="1800" class="img-contain">
    <div id="pdp-zoom-counter" class="pdp-zoom-counter" aria-live="polite"></div>
  </div>
  <script>
  (function() {
    var overlay   = document.getElementById('pdp-zoom-overlay');
    var largeImg  = document.getElementById('pdp-zoom-img-large');
    var closeBtn  = document.getElementById('pdp-zoom-close');
    var prevBtn   = document.getElementById('pdp-zoom-prev');
    var nextBtn   = document.getElementById('pdp-zoom-next');
    var counter   = document.getElementById('pdp-zoom-counter');

    function resizeImage(src, width) {
      try {
        var url = new URL(src, window.location.origin);
        url.searchParams.set('width', width);
        return url.toString();
      } catch (e) {
        return src;
      }
    }

    function normalizeImageUrl(src) {
      if (!src) return '';
      try {
        var url = new URL(src, window.location.origin);
        url.searchParams.delete('width');
        url.searchParams.delete('height');
        return url.origin + url.pathname + url.search;
      } catch (e) {
        return src.replace(/[?&](width|height)=\d+/g, '').replace(/[?&]$/, '');
      }
    }

    function collectImages() {
      var collected = [];
      function addImage(src) {
        var normalized = normalizeImageUrl(src);
        if (!normalized || collected.some(function(image) {
          return normalizeImageUrl(image) === normalized;
        })) return;
        collected.push(src);
      }

      document.querySelectorAll('[data-media-src]').forEach(function(thumb) {
        addImage(thumb.dataset.mediaSrc);
      });
      document.querySelectorAll('.pdp-zoom-img').forEach(function(img) {
        if (img.closest('.pdp-thumb-btn')) return;
        addImage(img.getAttribute('data-zoom-src') || img.currentSrc || img.src);
      });
      return collected;
    }

    var images = collectImages();

    var currentIndex = 0;

    function showAt(index) {
      if (images.length === 0) return;
      // Wrap around so prev/next never hit a dead end on the first/last frame.
      currentIndex = ((index % images.length) + images.length) % images.length;
      var src = images[currentIndex];
      largeImg.src = resizeImage(src, 1800);
      counter.textContent = (currentIndex + 1) + ' / ' + images.length;
      overlay.setAttribute('aria-label', 'Image ' + (currentIndex + 1) + ' of ' + images.length);
    }

    function openZoom(src, index) {
      if (images.length > 0 && typeof index === 'number') {
        showAt(index);
      } else {
        largeImg.src = resizeImage(src, 1800);
        counter.textContent = '1 / 1';
        currentIndex = 0;
      }
      overlay.style.display = 'flex';
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeZoom() {
      overlay.style.display = 'none';
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.pdp-zoom-img').forEach(function(img) {
      img.addEventListener('click', function(e) {
        // If the click is on a thumbnail (which calls preventDefault itself to
        // swap the main image), let the existing handler win and only open the
        // zoom if this is the main product image.
        if (img.classList.contains('pdp-thumb-btn') || img.closest('.pdp-thumb-btn')) {
          return;
        }
        var source = this.getAttribute('data-zoom-src') || this.currentSrc || this.src;
        var index = images.findIndex(function(image) {
          return normalizeImageUrl(image) === normalizeImageUrl(source);
        });
        openZoom(source, index >= 0 ? index : 0);
      });
    });

    prevBtn.addEventListener('click', function(e) { e.stopPropagation(); showAt(currentIndex - 1); });
    nextBtn.addEventListener('click', function(e) { e.stopPropagation(); showAt(currentIndex + 1); });

    closeBtn.addEventListener('click', function(e) { e.stopPropagation(); closeZoom(); });
    overlay.addEventListener('click', function(e) {
      if (e.target === closeBtn || closeBtn.contains(e.target)) return;
      if (e.target === prevBtn || prevBtn.contains(e.target)) return;
      if (e.target === nextBtn || nextBtn.contains(e.target)) return;
      closeZoom();
    });
    document.addEventListener('keydown', function(e) {
      if (overlay.style.display !== 'flex') return;
      if (e.key === 'Escape') { closeZoom(); }
      else if (e.key === 'ArrowLeft')  { showAt(currentIndex - 1); }
      else if (e.key === 'ArrowRight') { showAt(currentIndex + 1); }
    });

    // Re-scan images every time the user opens the zoom: if a previous/next
    // thumb has been re-rendered (e.g. by AJAX variant switch), pick up the
    // current src set instead of the page-load snapshot.
    var originalOpen = openZoom;
    openZoom = function(src, index) {
      images = collectImages();
      originalOpen(src, index);
    };
  })();
  </script>
{%- endif -%}

<script type="application/json" id="product-variants-{{ section.id }}">{{ product.variants | json }}</script>
<script>
(function() {
  var sectionId = {{ section.id | json }};
  var product = {
    variants: JSON.parse(document.getElementById('product-variants-' + sectionId).textContent)
  };
  /* Normalised the same way as the option buttons in product-info-blocks: the
     selected value can arrive as a product_option_value drop, and seeding the
     map with an object meant no combination ever matched a variant. */
  var selectedOptions = {};
  {%- for option in product.options_with_values -%}
    {%- assign selected_name = option.selected_value.name | default: option.selected_value -%}
    selectedOptions[{{ option.position }}] = {{ selected_name | json }};
  {%- endfor -%}

  /* FIX: previously used a regex on the old _NNNx filename-suffix pattern
     (e.g. "_900x.jpg"), which does nothing on Shopify's modern CDN URLs that
     size images via a "?width=" query param instead. That left the wrong /
     original-size image loaded after a variant switch. This resizes via the
     query param, same convention as image_url: elsewhere in this file. */
  function resizeImage(url, width) {
    try {
      var u = new URL(url, window.location.origin);
      u.searchParams.set('width', width);
      return u.toString();
    } catch (e) {
      return url;
    }
  }

  function updateOptionAvailability() {
    document.querySelectorAll('[data-variant-option][data-variant-value]').forEach(function(button) {
      var position = button.dataset.variantOption;
      var value = button.dataset.variantValue;
      var possible = product.variants.some(function(variant) {
        if (!variant.available || variant['option' + position] !== value) return false;
        return Object.keys(selectedOptions).every(function(pos) {
          return pos === position || variant['option' + pos] === selectedOptions[pos];
        });
      });
      button.disabled = !possible;
      button.setAttribute('aria-disabled', possible ? 'false' : 'true');
      button.classList.toggle('is-unavailable', !possible);
    });
  }

  function updateVariantUrl(variantId) {
    if (window.history && window.history.replaceState) {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variantId);
      window.history.replaceState({}, '', url.toString());
    }
  }

  window.selectVariant = function(btn, optionName, value, position) {
    selectedOptions[position] = value;
    btn.closest('.pdp-option-values').querySelectorAll('button').forEach(function(b) {
      b.classList.remove('active');
    });
    btn.classList.add('active');
    var label = document.getElementById('selected-value-' + position);
    if (label) label.textContent = ': ' + value;

    var match = product.variants.find(function(v) {
      return Object.keys(selectedOptions).every(function(pos) {
        return v['option' + pos] === selectedOptions[pos];
      });
    });
    if (!match) return;
    updateOptionAvailability();
    updateVariantUrl(match.id);

    var variantIdInput = document.getElementById('variant-id');
    if (variantIdInput) variantIdInput.value = match.id;

    document.dispatchEvent(new CustomEvent('variant-change', {
      detail: { variantId: match.id, available: match.available }
    }));

    var priceEl = document.getElementById('product-price');
    var moneyFormat = {{ settings.currency_code_enabled_product_pages | default: false | json }} ? {{ shop.money_with_currency_format | json }} : {{ shop.money_format | json }};
    if (priceEl) {
      priceEl.textContent = window.Meridian.formatMoney(match.price, moneyFormat);
    }

    var comparePriceEl = document.getElementById('product-compare-price');
    var savingsEl = document.getElementById('product-savings');
    if (comparePriceEl) {
      comparePriceEl.textContent = match.compare_at_price > match.price
        ? window.Meridian.formatMoney(match.compare_at_price, moneyFormat)
        : '';
      comparePriceEl.hidden = !(match.compare_at_price > match.price);
    }
    if (savingsEl) {
      if ({{ settings.show_savings_tag | default: false | json }} && match.compare_at_price > match.price) {
        var saved = match.compare_at_price - match.price;
        savingsEl.textContent = {{ settings.savings_tag_text | default: 'Save' | json }} + ' ' + (
          {{ settings.savings_tag_format | default: 'amount' | json }} === 'percent'
            ? Math.round(saved * 100 / match.compare_at_price) + '%'
            : window.Meridian.formatMoney(saved, moneyFormat)
        );
        savingsEl.hidden = false;
      } else {
        savingsEl.hidden = true;
      }
    }

    var unitPriceEl = document.getElementById('product-unit-price');
    if (unitPriceEl) {
      if (match.unit_price_measurement && match.unit_price != null) {
        var refValue = match.unit_price_measurement.reference_value;
        var unit = (refValue !== 1 ? refValue : '') + match.unit_price_measurement.reference_unit;
        var unitPriceText = {{ 'products.product.price.unit_price' | t: price: '[price]', unit: '[unit]' | json }};
        unitPriceEl.innerHTML = '<p class="t-body t-11 unit-price"></p>';
        unitPriceEl.firstChild.textContent = unitPriceText
          .replace('[price]', window.Meridian.formatMoney(match.unit_price, {{ shop.money_format | json }}))
          .replace('[unit]', unit);
      } else {
        unitPriceEl.innerHTML = '';
      }
    }

    var skuEl = document.getElementById('product-sku');
    if (skuEl) {
      skuEl.textContent = {{ 'products.product.sku' | t | json }} + ': ' + (match.sku || '');
      skuEl.style.display = match.sku ? '' : 'none';
    }

    var submitBtn = document.querySelector('#product-form button[type="submit"]');
    var addToCartLabel = {%- if is_preorder -%}{{ settings.preorder_button_label | default: 'Pre-order now' | json }}{%- else -%}{{ 'products.product.add_to_cart' | t | json }}{%- endif -%};
    if (submitBtn) {
      submitBtn.disabled = !match.available;
      var submitLabel = match.available ? addToCartLabel : {{ 'products.product.sold_out' | t | json }};
      var submitLabelEl = submitBtn.querySelector('span');
      if (submitLabelEl) { submitLabelEl.textContent = submitLabel; } else { submitBtn.textContent = submitLabel; }
    }

    if (match.featured_image) {
      ['main-product-img', 'editorial-main-img', 'split-main-img'].forEach(function (id) {
        var mainImg = document.getElementById(id);
        if (mainImg) {
          mainImg.src = resizeImage(match.featured_image.src, 900);
          mainImg.srcset = mainImg.src;
        }
      });
      document.querySelectorAll('[data-gallery] [data-media-index]').forEach(function(thumb) {
        thumb.classList.toggle('active', thumb.dataset.mediaSrc.indexOf(match.featured_image.src) !== -1);
      });
    }

    var availability = document.getElementById('variant-availability');
    if (availability) {
      availability.textContent = match.available
        ? {{ 'products.product.in_stock' | t | json }}
        : {{ 'products.product.sold_out' | t | json }};
      availability.classList.toggle('is-unavailable', !match.available);
    }

    var stickyPrice = document.getElementById('sticky-atc-price-' + sectionId);
    if (stickyPrice && priceEl) stickyPrice.textContent = priceEl.textContent;
    var stickyVariant = document.getElementById('sticky-atc-variant-' + sectionId);
    if (stickyVariant) stickyVariant.textContent = match.title || '';
    var stickyImg = document.querySelector('#sticky-atc-' + sectionId + ' .pdp-sticky-atc__img');
    if (stickyImg && match.featured_image) {
      stickyImg.src = resizeImage(match.featured_image.src, 120);
    }
    var stickyBtn = document.getElementById('sticky-atc-btn-' + sectionId);
    if (stickyBtn) {
      stickyBtn.disabled = !match.available;
      var stickyLabel = stickyBtn.querySelector('.pdp-sticky-atc__btn-label');
      if (stickyLabel) {
        stickyLabel.textContent = match.available ? addToCartLabel : {{ 'products.product.sold_out' | t | json }};
      }
      var stickyButtonPrice = document.getElementById('sticky-atc-button-price-' + sectionId);
      if (stickyButtonPrice && priceEl) stickyButtonPrice.textContent = priceEl.textContent;
    }
  };

  document.addEventListener('click', function(event) {
    var button = event.target.closest('[data-variant-option][data-variant-value]');
    if (!button || button.disabled) return;
    window.selectVariant(button, '', button.dataset.variantValue, button.dataset.variantOption);
  });

  updateOptionAvailability();

  window.openSizeGuide = function(sectionId) {
    var modal = document.getElementById('size-guide-modal-' + sectionId);
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    } else {
      var anchor = document.getElementById('size-guide-anchor');
      if (anchor) anchor.scrollIntoView({ behavior: 'smooth' });
    }
  };

  window.selectTab = function(blockId, index) {
    document.querySelectorAll('[id^="product-tab-' + blockId + '-"]').forEach(function(panel) {
      panel.classList.remove('active');
    });
    var target = document.getElementById('product-tab-' + blockId + '-' + index);
    if (target) target.classList.add('active');
    document.querySelectorAll('.product-tab-btn').forEach(function(b) {
      b.classList.toggle('active', b.dataset.tab == index);
    });
  };
})();
</script>

{%- if settings.product_show_sticky_atc -%}
  {%- comment -%}
    Floating add-to-cart bar. Everything in it (thumbnail / title / price /
    variant / quantity / close button / position) is merchant-controlled from
    Theme settings → Product pages → Floating add-to-cart bar.
    The quantity stepper mirrors #qty, so the bar and the in-page buy form
    always submit the same number.
  {%- endcomment -%}
  {%- assign sticky_variant = product.selected_or_first_available_variant -%}
  {%- assign sticky_position = settings.sticky_atc_position | default: 'bottom' -%}
  {%- assign sticky_show_qty = false -%}
  {%- if settings.sticky_atc_show_quantity and settings.product_show_quantity_selector -%}
    {%- assign sticky_show_qty = true -%}
  {%- endif -%}

  <div
    id="sticky-atc-{{ section.id }}"
    class="pdp-sticky-atc pdp-sticky-atc--{{ sticky_position }}"
    data-sticky-atc
    data-product-handle="{{ product.handle }}"
    aria-hidden="true"
  >
    <div class="page-width pdp-sticky-atc__inner">
      <div class="pdp-sticky-atc__info">
        {%- if settings.sticky_atc_show_image and product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 120 }}" srcset="{{ product.featured_media | image_url: width: 120 }} 120w,
                    {{ product.featured_media | image_url: width: 240 }} 240w" sizes="120px" alt="" class="pdp-sticky-atc__img" width="60" height="60" loading="lazy">
        {%- endif -%}
        <div class="pdp-sticky-atc__text">
          {%- if settings.sticky_atc_show_title -%}
            <p class="pdp-sticky-atc__title">{{ product.title }}</p>
          {%- endif -%}
          <p class="pdp-sticky-atc__meta">
            {%- if settings.sticky_atc_show_price -%}
              <span class="pdp-sticky-atc__price" id="sticky-atc-price-{{ section.id }}">{{ sticky_variant.price | money }}</span>
            {%- endif -%}
            {%- if settings.sticky_atc_show_variant and product.has_only_default_variant == false -%}
              <span class="pdp-sticky-atc__variant" id="sticky-atc-variant-{{ section.id }}">{{ sticky_variant.title }}</span>
            {%- endif -%}
          </p>
        </div>
      </div>

      <div class="pdp-sticky-atc__actions">
        {%- if sticky_show_qty -%}
          <div class="pdp-sticky-atc__qty" data-sticky-qty>
            <button type="button" class="pdp-sticky-atc__qty-btn" data-sticky-qty-minus aria-label="{{ 'products.product.quantity' | t }} −">−</button>
            <input
              type="number"
              id="sticky-atc-qty-{{ section.id }}"
              class="pdp-sticky-atc__qty-input"
              value="1"
              min="1"
              inputmode="numeric"
              data-sticky-qty-input
              aria-label="{{ 'products.product.quantity' | t }}"
            >
            <button type="button" class="pdp-sticky-atc__qty-btn" data-sticky-qty-plus aria-label="{{ 'products.product.quantity' | t }} +">+</button>
          </div>
        {%- endif -%}

        {%- render 'buy-buttons', product: product, is_preorder: is_preorder, sticky: true -%}

        {%- if settings.sticky_atc_show_close -%}
          <button type="button" class="pdp-sticky-atc__close" data-sticky-close aria-label="{{ 'accessibility.close' | t }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
  (function() {
    var bar = document.getElementById('sticky-atc-{{ section.id }}');
    var anchor = document.getElementById('pdp-buy-anchor');
    if (!bar) return;

    var dismissKey = 'meridian:sticky-atc-dismissed:' + bar.dataset.productHandle;
    var atTop = bar.classList.contains('pdp-sticky-atc--top');

    function dismissed() {
      try { return sessionStorage.getItem(dismissKey) === '1'; } catch (e) { return false; }
    }

    function show(visible) {
      if (visible && dismissed()) visible = false;
      bar.classList.toggle('pdp-sticky-atc--visible', visible);
      bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
    }

    var closeBtn = bar.querySelector('[data-sticky-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        try { sessionStorage.setItem(dismissKey, '1'); } catch (e) {}
        show(false);
      });
    }

    // Quantity stepper — mirrors the in-page #qty control both ways so the
    // buy form submits whatever the customer last set, wherever they set it.
    var stickyQty = bar.querySelector('[data-sticky-qty-input]');
    var pageQty = document.getElementById('qty');

    if (stickyQty) {
      var readQty = function(el) { return Math.max(1, parseInt(el.value, 10) || 1); };

      // The "dropdown" quantity style renders #qty as a <select> with a fixed
      // list of options — going past the last one would blank it out.
      var maxQty = Infinity;
      if (pageQty && pageQty.tagName === 'SELECT' && pageQty.options.length) {
        maxQty = parseInt(pageQty.options[pageQty.options.length - 1].value, 10) || Infinity;
        stickyQty.setAttribute('max', maxQty);
      }

      var writeQty = function(value) {
        value = Math.min(value, maxQty);
        stickyQty.value = value;
        if (pageQty) {
          pageQty.value = value;
          pageQty.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };

      if (pageQty) stickyQty.value = readQty(pageQty);

      bar.querySelector('[data-sticky-qty-minus]').addEventListener('click', function() {
        writeQty(Math.max(1, readQty(stickyQty) - 1));
      });
      bar.querySelector('[data-sticky-qty-plus]').addEventListener('click', function() {
        writeQty(readQty(stickyQty) + 1);
      });
      stickyQty.addEventListener('change', function() { writeQty(readQty(stickyQty)); });

      if (pageQty) {
        pageQty.addEventListener('change', function() { stickyQty.value = readQty(pageQty); });
      }
    }

    if (!anchor || !('IntersectionObserver' in window)) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        // Bottom bar shows once the buy form has scrolled off the top;
        // a top bar shows whenever the form is out of view in either direction.
        var scrolledPast = atTop ? true : entry.boundingClientRect.top < 0;
        show(!entry.isIntersecting && scrolledPast);
      });
    }, { threshold: 0 });
    observer.observe(anchor);
  })();
  </script>
{%- endif -%}

