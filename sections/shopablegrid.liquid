<script>
  (function () {
    'use strict';

    /* ==========================================================
       SECTION — bail out early if anything core is missing
       ========================================================== */
    const section = document.getElementById('{{ section_id }}');
    if (!section) {
      return;
    }

    /* ==========================================================
       POPUP ELEMENTS — all read from data-* hooks above
       ========================================================== */
    const popup = section.querySelector('[data-shoppable-popup]');
    if (!popup) {
      return;
    }
    const popupImage = section.querySelector('[data-popup-image]');
    const popupTitle = section.querySelector('[data-popup-title]');
    const popupPrice = section.querySelector('[data-popup-price]');
    const popupCompare = section.querySelector('[data-popup-compare]');
    const popupDescription = section.querySelector('[data-popup-description]');
    const popupVariants = section.querySelector('[data-popup-variants]');
    const popupStatus = section.querySelector('[data-popup-status]');
    const bundleVariantPicker = section.querySelector('[data-bundle-variant-picker]');
    const bundleVariantSelect = section.querySelector('[data-bundle-variant]');
    const bundleVariantImage = section.querySelector('[data-bundle-variant-image]');
    const bundleVariantTitle = section.querySelector('[data-bundle-variant-title]');
    const popupLink = section.querySelector('[data-popup-link]');
    const addToCartButton = section.querySelector('[data-popup-add-to-cart]');
    const addText = section.querySelector('[data-add-text]');
    const hotspots = section.querySelectorAll('.shoppable-hotspot');
    const closeButtons = section.querySelectorAll('[data-popup-close]');

    /* ==========================================================
       STATE
       ========================================================== */
    let currentProduct = null;
    let currentVariants = [];
    let currentOptions = [];
    let selectedOptions = {};
    let lastFocusedElement = null;
    let currentSizeDropdown = null;

    /* ==========================================================
       BUNDLE PRODUCT — JSON-encoded variant id from Liquid above
       ========================================================== */
    const defaultBundleVariantId = Number({{ bundle_variant_id | default: 0 }});
    const currencyCode = section.dataset.currency || 'USD';

    /* ==========================================================
       COLOR MAP — named colors -> hex, used to draw the color swatches
       ========================================================== */
    const colorMap = {
      black: '#000000',
      white: '#ffffff',
      blue: '#0000ff',
      red: '#ff0000',
      green: '#008000',
      yellow: '#ffff00',
      orange: '#ffa500',
      purple: '#800080',
      pink: '#ffc0cb',
      brown: '#8b4513',
      grey: '#808080',
      gray: '#808080',
      beige: '#f5f5dc',
      cream: '#fffdd0',
      navy: '#000080',
      maroon: '#800000',
      olive: '#808000',
      silver: '#c0c0c0',
      gold: '#ffd700',
      khaki: '#c3b091',
      tan: '#d2b48c',
      teal: '#008080',
      cyan: '#00ffff',
      magenta: '#ff00ff',
      lavender: '#e6e6fa',
      burgundy: '#800020',
      charcoal: '#36454f',
    };

    /* ==========================================================
       GET COLOR CODE — resolve a color option name to a hex value.
       Rules: hex value passes through, hex found inside the string
       is extracted, known names use the map, else a default grey.
       ========================================================== */
    function getColorCode(colorName) {
      if (!colorName) {
        return '#e5e5e5';
      }
      const value = String(colorName).trim();
      if (/^#[0-9a-f]{3,8}$/i.test(value)) {
        return value;
      }
      const hexMatch = value.match(/#[0-9a-f]{3,8}/i);
      if (hexMatch) {
        return hexMatch[0];
      }
      const normalized = value.toLowerCase();
      if (colorMap[normalized]) {
        return colorMap[normalized];
      }
      if (normalized.includes('dark blue')) {
        return '#00008b';
      }
      if (normalized.includes('light blue')) {
        return '#add8e6';
      }
      if (normalized.includes('dark green')) {
        return '#006400';
      }
      if (normalized.includes('light green')) {
        return '#90ee90';
      }
      if (normalized.includes('dark grey') || normalized.includes('dark gray')) {
        return '#555555';
      }
      if (
        normalized.includes('light grey') ||
        normalized.includes('light gray')
      ) {
        return '#d3d3d3';
      }
      return '#e5e5e5';
    }

    /* ==========================================================
       NORMALIZE OPTION NAME — lowercase/trim for option-type matching
       ========================================================== */
    function normalizeOptionName(name) {
      return String(name || '')
        .trim()
        .toLowerCase();
    }

    /* ==========================================================
       GET OPTION TYPE — classify an option as 'color', 'size' or 'normal'
       ========================================================== */
    function getOptionType(option) {
      const name = normalizeOptionName(option.name);
      if (name === 'color') {
        return 'color';
      }
      if (name === 'size') {
        return 'size';
      }
      return 'normal';
    }

    /* ==========================================================
       OPEN POPUP — populate all fields from the hotspot's data-* attrs
       ========================================================== */
    function openPopup(button) {
      lastFocusedElement = button;
      const productTitle = button.getAttribute('data-product-title') || '';
      const productPrice = button.getAttribute('data-product-price') || '';
      const productCompare =
        button.getAttribute('data-product-compare-price') || '';
      const productImage = button.getAttribute('data-product-image') || '';
      const productUrl = button.getAttribute('data-product-url') || '#';
      const productDescription =
        button.getAttribute('data-product-description') || '';
      currentProduct = {
        id: button.getAttribute('data-product-id'),
        title: productTitle,
        price: productPrice,
        comparePrice: productCompare,
        image: productImage,
        url: productUrl,
        description: productDescription,
      };

      /* ---- Variants ---- */
      try {
        currentVariants = JSON.parse(
          button.getAttribute('data-product-variants') || '[]',
        );
      } catch (error) {
        console.error('Variant JSON error:', error);
        currentVariants = [];
      }

      /* ---- Options ---- */
      try {
        currentOptions = JSON.parse(
          button.getAttribute('data-product-options') || '[]',
        );
      } catch (error) {
        console.error('Option JSON error:', error);
        currentOptions = [];
      }

      /* ---- Basic info ---- */
      popupTitle.textContent = productTitle;
      popupPrice.textContent = productPrice;
      popupLink.href = productUrl;
      popupStatus.textContent = '';

      /* ---- Image ---- */
      if (productImage) {
        popupImage.src = productImage;
        popupImage.alt = productTitle;
        popupImage.style.display = 'block';
      } else {
        popupImage.removeAttribute('src');
        popupImage.style.display = 'none';
      }

      /* ---- Compare price (only shown when a real sale price exists) ---- */
      if (productCompare) {
        popupCompare.textContent = productCompare;
        popupCompare.style.display = 'inline';
      } else {
        popupCompare.textContent = '';
        popupCompare.style.display = 'none';
      }

      /* ---- Description ---- */
      popupDescription.innerHTML = productDescription || '';

      /* ---- Reset selections ---- */
      selectedOptions = {};

      /* Automatically pre-select the first available value for non-size
         options so only Size remains for the customer to choose. */
      currentOptions.forEach(function (option, optionIndex) {
        const type = getOptionType(option);
        if (type === 'size') {
          return;
        }
        const availableVariant = currentVariants.find(function (variant) {
          return (
            variant.available &&
            variant.options &&
            variant.options[optionIndex] !== undefined
          );
        });
        if (availableVariant && availableVariant.options) {
          selectedOptions[option.name] = availableVariant.options[optionIndex];
        }
      });

      /* ---- Render + enable ---- */
      renderVariantOptions();
      updateVariantState();

      /* ---- Open ---- */
      popup.classList.add('is-active');
      popup.setAttribute('aria-hidden', 'false');
      button.setAttribute('aria-expanded', 'true');
      document.body.classList.add('shoppable-popup-open');
      const closeButton = section.querySelector('.shoppable-product-popup-close');
      if (closeButton) {
        setTimeout(function () {
          closeButton.focus();
        }, 50);
      }
    }

    /* ==========================================================
       RENDER VARIANTS — build option UI. Order is always
       color -> size -> other, regardless of product option order.
       ========================================================== */
    function renderVariantOptions() {
      if (!popupVariants) {
        return;
      }
      popupVariants.innerHTML = '';
      currentSizeDropdown = null;
      const sortedOptions = [];
      const colorOptions = currentOptions.filter(function (option) {
        return getOptionType(option) === 'color';
      });
      const sizeOptions = currentOptions.filter(function (option) {
        return getOptionType(option) === 'size';
      });
      const otherOptions = currentOptions.filter(function (option) {
        return getOptionType(option) === 'normal';
      });
      sortedOptions.push(...colorOptions);
      sortedOptions.push(...sizeOptions);
      sortedOptions.push(...otherOptions);
      sortedOptions.forEach(function (option) {
        const optionIndex = currentOptions.findIndex(function (originalOption) {
          return originalOption.name === option.name;
        });
        const type = getOptionType(option);
        if (type === 'size') {
          renderSizeDropdown(option, optionIndex);
        } else {
          renderButtonOptionGroup(option, optionIndex, type);
        }
      });
    }

    /* ==========================================================
       RENDER BUTTON OPTION GROUP — color + normal options as buttons
       ========================================================== */
    function renderButtonOptionGroup(option, optionIndex, type) {
      const group = document.createElement('div');
      group.className = 'shoppable-variant-group';
      const label = document.createElement('div');
      label.className = 'shoppable-variant-label';
      label.textContent = option.name;
      group.appendChild(label);
      const optionsContainer = document.createElement('div');
      optionsContainer.className = 'shoppable-variant-options';
      option.values.forEach(function (value) {
        const optionButton = document.createElement('button');
        optionButton.type = 'button';
        optionButton.className = 'shoppable-variant-option';
        optionButton.dataset.optionName = option.name;
        optionButton.dataset.optionValue = value;
        if (type === 'color') {
          optionButton.classList.add('shoppable-color-option');
          /* 10px color left border gets its hex from the color name */
          optionButton.style.setProperty('--color-code', getColorCode(value));
          const colorName = document.createElement('span');
          colorName.className = 'shoppable-color-name';
          colorName.textContent = value;
          optionButton.appendChild(colorName);
        } else {
          optionButton.classList.add('shoppable-normal-option');
          const optionName = document.createElement('span');
          optionName.className = 'shoppable-option-name';
          optionName.textContent = value;
          optionButton.appendChild(optionName);
        }
        optionButton.addEventListener('click', function () {
          if (optionButton.disabled) {
            return;
          }
          selectedOptions[option.name] = value;
          resetInvalidSize();
          updateVariantState();
        });
        optionsContainer.appendChild(optionButton);
      });
      group.appendChild(optionsContainer);
      popupVariants.appendChild(group);
    }

    /* ==========================================================
       RENDER SIZE DROPDOWN — build the custom trigger + menu buttons
       ========================================================== */
    function renderSizeDropdown(option, optionIndex) {
      const group = document.createElement('div');
      group.className = 'shoppable-variant-group';
      const label = document.createElement('div');
      label.className = 'shoppable-variant-label';
      label.textContent = 'CHOOSE SIZE';
      group.appendChild(label);
      const dropdown = document.createElement('div');
      dropdown.className = 'shoppable-size-dropdown';
      currentSizeDropdown = dropdown;

      /* ========================================================
         TRIGGER
         ======================================================== */
      const trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.className = 'shoppable-size-dropdown-trigger';
      trigger.setAttribute('aria-haspopup', 'listbox');
      trigger.setAttribute('aria-expanded', 'false');
      const currentText = document.createElement('span');
      currentText.className = 'shoppable-size-dropdown-current is-placeholder';
      currentText.textContent = 'Choose Size';
      const arrow = document.createElement('span');
      arrow.className = 'shoppable-size-dropdown-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      trigger.appendChild(currentText);
      trigger.appendChild(arrow);

      /* ========================================================
         MENU — one button per size value
         ======================================================== */
      const menu = document.createElement('div');
      menu.className = 'shoppable-size-dropdown-menu';
      menu.setAttribute('role', 'listbox');
      menu.setAttribute('aria-label', 'Choose Size');
      option.values.forEach(function (value) {
        const sizeOption = document.createElement('button');
        sizeOption.type = 'button';
        sizeOption.className = 'shoppable-size-dropdown-option';
        sizeOption.dataset.optionName = option.name;
        sizeOption.dataset.optionValue = value;
        sizeOption.setAttribute('role', 'option');
        const sizeText = document.createElement('span');
        sizeText.textContent = value;
        const check = document.createElement('span');
        check.className = 'shoppable-size-dropdown-option-check';
        check.textContent = '✓';
        check.setAttribute('aria-hidden', 'true');
        sizeOption.appendChild(sizeText);
        sizeOption.appendChild(check);
        sizeOption.addEventListener('click', function (event) {
          event.stopPropagation();
          if (sizeOption.disabled) {
            return;
          }
          selectedOptions[option.name] = value;
          currentText.textContent = value;
          currentText.classList.remove('is-placeholder');
          closeSizeDropdown();
          updateVariantState();
        });
        menu.appendChild(sizeOption);
      });
      dropdown.appendChild(trigger);
      dropdown.appendChild(menu);
      trigger.addEventListener('click', function (event) {
        event.stopPropagation();
        toggleSizeDropdown();
      });
      group.appendChild(dropdown);
      popupVariants.appendChild(group);
    }

    /* ==========================================================
       TOGGLE / OPEN / CLOSE SIZE DROPDOWN
       ========================================================== */
    function toggleSizeDropdown() {
      if (!currentSizeDropdown) {
        return;
      }
      const isOpen = currentSizeDropdown.classList.contains('is-open');
      if (isOpen) {
        closeSizeDropdown();
      } else {
        openSizeDropdown();
      }
    }

    function openSizeDropdown() {
      if (!currentSizeDropdown) {
        return;
      }
      currentSizeDropdown.classList.add('is-open');
      const trigger = currentSizeDropdown.querySelector(
        '.shoppable-size-dropdown-trigger',
      );
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'true');
      }
    }

    function closeSizeDropdown() {
      if (!currentSizeDropdown) {
        return;
      }
      currentSizeDropdown.classList.remove('is-open');
      const trigger = currentSizeDropdown.querySelector(
        '.shoppable-size-dropdown-trigger',
      );
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    }

    /* ==========================================================
       RESET INVALID SIZE — clear the size if the current color/other
       choice no longer offers it (e.g. Black is changed away from).
       ========================================================== */
    function resetInvalidSize() {
      const sizeOptionIndex = currentOptions.findIndex(function (option) {
        return getOptionType(option) === 'size';
      });
      if (sizeOptionIndex === -1) {
        return;
      }
      const sizeOption = currentOptions[sizeOptionIndex];
      const selectedSize = selectedOptions[sizeOption.name];
      if (!selectedSize) {
        return;
      }
      const stillAvailable = isOptionAvailable(
        sizeOptionIndex,
        sizeOption.name,
        selectedSize,
      );
      if (!stillAvailable) {
        delete selectedOptions[sizeOption.name];
      }
    }

    /* ==========================================================
       FIND SELECTED VARIANT — match the currently selected option
       values against the variant list; returns null until complete.
       ========================================================== */
    function findSelectedVariant() {
      if (!currentVariants.length) {
        return null;
      }
      const hasAllOptions = currentOptions.every(function (option) {
        return (
          selectedOptions[option.name] !== undefined &&
          selectedOptions[option.name] !== ''
        );
      });
      if (!hasAllOptions) {
        return null;
      }
      return (
        currentVariants.find(function (variant) {
          if (!variant.options) {
            return false;
          }
          return currentOptions.every(function (option, index) {
            return variant.options[index] === selectedOptions[option.name];
          });
        }) || null
      );
    }

    /* ==========================================================
       CHECK OPTION AVAILABILITY — is this value buildable into a real
       variant given the other options currently selected?
       ========================================================== */
    function isOptionAvailable(optionIndex, optionName, optionValue) {
      return currentVariants.some(function (variant) {
        if (!variant.available || !variant.options) {
          return false;
        }
        if (variant.options[optionIndex] !== optionValue) {
          return false;
        }
        return currentOptions.every(function (option, index) {
          if (index === optionIndex) {
            return true;
          }
          const selected = selectedOptions[option.name];
          if (!selected) {
            return true;
          }
          return variant.options[index] === selected;
        });
      });
    }

    /* ==========================================================
       FORMAT MONEY — cents -> the active Shopify store currency
       ========================================================== */
    function formatMoney(cents) {
      const value = Number(cents || 0) / 100;
      try {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: currencyCode,
        }).format(value);
      } catch (error) {
        return value.toFixed(2);
      }
    }

    /* ==========================================================
       UPDATE VARIANT PRICE — swap the popup price for the selected
       variant's price (+ compare price when it is on sale).
       ========================================================== */
    function updateVariantPrice(selectedVariant) {
      if (!selectedVariant) {
        return;
      }
      if (selectedVariant.price !== undefined) {
        popupPrice.textContent = formatMoney(selectedVariant.price);
      }
      if (
        selectedVariant.compare_at_price &&
        Number(selectedVariant.compare_at_price) > Number(selectedVariant.price)
      ) {
        popupCompare.textContent = formatMoney(selectedVariant.compare_at_price);
        popupCompare.style.display = 'inline';
      } else {
        popupCompare.textContent = '';
        popupCompare.style.display = 'none';
      }
    }

    /* ==========================================================
       UPDATE SIZE DROPDOWN UI — disable/enable sizes based on the
       currently selected color/other options, and keep its label
       ("Choose Size" prompt vs chosen value) in sync.
       ========================================================== */
    function updateSizeDropdownState() {
      if (!currentSizeDropdown) {
        return;
      }
      const sizeOptionIndex = currentOptions.findIndex(function (option) {
        return getOptionType(option) === 'size';
      });
      if (sizeOptionIndex === -1) {
        return;
      }
      const sizeOption = currentOptions[sizeOptionIndex];
      const selectedSize = selectedOptions[sizeOption.name];
      const currentText = currentSizeDropdown.querySelector(
        '.shoppable-size-dropdown-current',
      );
      const sizeButtons = currentSizeDropdown.querySelectorAll(
        '.shoppable-size-dropdown-option',
      );
      sizeButtons.forEach(function (button) {
        const value = button.dataset.optionValue;
        const available = isOptionAvailable(
          sizeOptionIndex,
          sizeOption.name,
          value,
        );
        button.disabled = !available;
        button.classList.toggle('is-unavailable', !available);
        const selected = selectedSize === value;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
      if (currentText) {
        if (selectedSize) {
          currentText.textContent = selectedSize;
          currentText.classList.remove('is-placeholder');
        } else {
          currentText.textContent = 'Choose Size';
          currentText.classList.add('is-placeholder');
        }
      }
    }

    /* ==========================================================
       UPDATE VARIANT STATE — the master re-render pass: refreshes
       every option button, the size dropdown, the price, and the
       add-to-cart button label/state after any selection change.
       ========================================================== */
    function updateVariantState() {
      if (!popupVariants) {
        return;
      }
      const optionButtons = popupVariants.querySelectorAll(
        '.shoppable-variant-option',
      );
      optionButtons.forEach(function (button) {
        const optionName = button.dataset.optionName;
        const optionValue = button.dataset.optionValue;
        const optionIndex = currentOptions.findIndex(function (option) {
          return option.name === optionName;
        });
        const selected = selectedOptions[optionName] === optionValue;
        button.classList.toggle('is-selected', selected);
        const available = isOptionAvailable(optionIndex, optionName, optionValue);
        button.disabled = !available;
        button.classList.toggle('is-unavailable', !available);
      });
      updateSizeDropdownState();
      const selectedVariant = findSelectedVariant();
      const hasBundle = shouldAddBundle(selectedVariant);
      if (bundleVariantPicker) {
        bundleVariantPicker.hidden = !hasBundle;
      }

      /* ---- Price ---- */
      if (selectedVariant && selectedVariant.available) {
        updateVariantPrice(selectedVariant);
      } else {
        // Fallback: restore the base product price from the hotspot data.
        if (currentProduct) {
          popupPrice.textContent = currentProduct.price;
          if (currentProduct.comparePrice) {
            popupCompare.textContent = currentProduct.comparePrice;
            popupCompare.style.display = 'inline';
          } else {
            popupCompare.textContent = '';
            popupCompare.style.display = 'none';
          }
        }
      }

      /* ---- Add-to-cart label + enabled state ---- */
      if (selectedVariant && selectedVariant.available) {
        addToCartButton.disabled = false;
        addText.textContent = 'ADD TO CART';
      } else {
        addToCartButton.disabled = true;
        const hasSizeOption = currentOptions.some(function (option) {
          return getOptionType(option) === 'size';
        });
        const sizeSelected = currentOptions.some(function (option) {
          return getOptionType(option) === 'size' && selectedOptions[option.name];
        });
        if (hasSizeOption && !sizeSelected) {
          addText.textContent = 'CHOOSE SIZE';
        } else if (selectedVariant && !selectedVariant.available) {
          addText.textContent = 'SOLD OUT';
        } else {
          addText.textContent = 'CHOOSE OPTIONS';
        }
      }
    }

    /* ==========================================================
       SHOULD ADD BUNDLE — match Black plus a medium size. Shopify
       products often label Medium as "M", so accept both values.
       ========================================================== */
    function shouldAddBundle(selectedVariant) {
      if (
        !selectedVariant ||
        !Array.isArray(selectedVariant.options) ||
        !Array.isArray(currentOptions)
      ) {
        return false;
      }

      const hasBlack = selectedVariant.options.some(function (value) {
        return String(value).trim().toLowerCase() === 'black';
      });
      const hasMediumSize = currentOptions.some(function (option, index) {
        if (
          getOptionType(option) !== 'size' ||
          selectedVariant.options[index] === undefined
        ) {
          return false;
        }
        const size = String(selectedVariant.options[index]).trim().toLowerCase();
        return size === 'm' || size === 'medium';
      });

      return hasBlack && hasMediumSize;
    }

    /* ==========================================================
       ADD TO CART — POST the selected variant (+ optional bundle)
       to the Shopify AJAX cart, then refresh the cart UI.
       ========================================================== */
    async function addToCart() {
      const selectedVariant = findSelectedVariant();
      if (!selectedVariant || !selectedVariant.available || !selectedVariant.id) {
        return;
      }
      const bundleRequired = shouldAddBundle(selectedVariant);
      const selectedBundleVariantId = Number(
        bundleVariantSelect?.value || defaultBundleVariantId
      );
      if (bundleRequired && !selectedBundleVariantId) {
        popupStatus.textContent = section.dataset.cartErrorMessage;
        return;
      }
      addToCartButton.disabled = true;
      addToCartButton.classList.add('is-loading');
      addText.textContent = 'ADDING...';
      const items = [
        {
          id: Number(selectedVariant.id),
          quantity: 1,
        },
      ];

      /* ---- Automatic bundle ---- */
      if (bundleRequired) {
        if (selectedBundleVariantId !== Number(selectedVariant.id)) {
          items.push({ id: selectedBundleVariantId, quantity: 1 });
        }
      }

      /* ---- Shopify AJAX cart ---- */
      try {
        const root = window.Shopify?.routes?.root || '/';
        const response = await fetch(root + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            items: items,
            sections: 'cart-drawer,cart-icon-bubble,cart-live-region-text',
            sections_url: window.location.pathname,
          }),
        });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(
            data.description || data.message || section.dataset.cartErrorMessage,
          );
        }

        const cartResponse = await fetch(root + 'cart.js', {
          headers: { Accept: 'application/json' },
        });
        if (!cartResponse.ok) {
          throw new Error(section.dataset.cartErrorMessage);
        }
        const cart = await cartResponse.json();
        const cartVariantIds = new Set(
          (cart.items || []).map(function (item) {
            return Number(item.variant_id);
          }),
        );
        if (items.some(function (item) { return !cartVariantIds.has(item.id); })) {
          throw new Error(section.dataset.cartErrorMessage);
        }

        /* ---- Update cart UI with the returned section HTML ---- */
        if (data.sections) {
          updateCartSections(data.sections);
        }

        /* ---- Success ---- */
        popupStatus.textContent = '';
        addText.textContent = 'ADDED TO CART ✓';
        setTimeout(function () {
          openCartDrawer();
        }, 150);
        setTimeout(function () {
          closePopup();
        }, 500);
      } catch (error) {
        console.error('Shopify add to cart error:', error);
        popupStatus.textContent =
          error.message || section.dataset.cartErrorMessage;
        addText.textContent = 'TRY AGAIN';
        addToCartButton.disabled = false;
        addToCartButton.classList.remove('is-loading');
      }
    }

    /* ==========================================================
       UPDATE CART SECTIONS — swap updated section HTML into the DOM
       so drawer / icon / live-region reflect the new cart contents.
       ========================================================== */
    function updateCartSections(sections) {
      if (!sections) {
        return;
      }

      /* ---- Cart drawer ---- */
      if (sections['cart-drawer']) {
        const currentCartDrawer = document.querySelector('cart-drawer');
        if (currentCartDrawer) {
          const parser = new DOMParser();
          const parsedDocument = parser.parseFromString(
            sections['cart-drawer'],
            'text/html',
          );
          const newCartDrawer = parsedDocument.querySelector('cart-drawer');
          if (newCartDrawer) {
            currentCartDrawer.replaceWith(newCartDrawer);
          }
        }
      }

      /* ---- Cart icon bubble ---- */
      if (sections['cart-icon-bubble']) {
        const currentCartBubble = document.querySelector(
          '#shopify-section-cart-icon-bubble',
        );
        if (currentCartBubble) {
          const parser = new DOMParser();
          const parsedDocument = parser.parseFromString(
            sections['cart-icon-bubble'],
            'text/html',
          );
          const newCartBubble = parsedDocument.querySelector(
            '#shopify-section-cart-icon-bubble',
          );
          if (newCartBubble) {
            currentCartBubble.replaceWith(newCartBubble);
          }
        }
      }

      /* ---- Live region (screen-reader announcement) ---- */
      if (sections['cart-live-region-text']) {
        const currentLiveRegion = document.querySelector(
          '#shopify-section-cart-live-region-text',
        );
        if (currentLiveRegion) {
          const parser = new DOMParser();
          const parsedDocument = parser.parseFromString(
            sections['cart-live-region-text'],
            'text/html',
          );
          const newLiveRegion = parsedDocument.querySelector(
            '#shopify-section-cart-live-region-text',
          );
          if (newLiveRegion) {
            currentLiveRegion.replaceWith(newLiveRegion);
          }
        }
      }
    }

    /* ==========================================================
       OPEN CART DRAWER — prefer the native cart-drawer.open() method
       ========================================================== */
    function openCartDrawer() {
      const cartDrawer = document.querySelector('cart-drawer');
      if (!cartDrawer) {
        return;
      }
      if (typeof cartDrawer.open === 'function') {
        cartDrawer.open();
        return;
      }
      cartDrawer.classList.add('active');
    }

    /* ==========================================================
       CLOSE POPUP — hide, reset, and restore focus to the hotspot
       that opened it.
       ========================================================== */
    function closePopup() {
      closeSizeDropdown();
      popup.classList.remove('is-active');
      popup.setAttribute('aria-hidden', 'true');
      hotspots.forEach(function (hotspot) {
        hotspot.setAttribute('aria-expanded', 'false');
      });
      document.body.classList.remove('shoppable-popup-open');
      addToCartButton.classList.remove('is-loading');
      addToCartButton.disabled = true;
      addText.textContent = 'CHOOSE OPTIONS';
      popupStatus.textContent = '';
      if (lastFocusedElement) {
        try {
          lastFocusedElement.focus();
        } catch (error) {
          /* Ignore focus errors */
        }
      }
    }

    /* ==========================================================
       EVENT WIRING
       ========================================================== */

    /* ---- Hotspot clicks open the popup ---- */
    hotspots.forEach(function (hotspot) {
      hotspot.addEventListener('click', function () {
        openPopup(hotspot);
      });
    });

    /* ---- Add-to-cart ---- */
    if (addToCartButton) {
      addToCartButton.addEventListener('click', addToCart);
    }
    if (bundleVariantSelect) {
      bundleVariantSelect.addEventListener('change', function () {
        const selectedOption = bundleVariantSelect.selectedOptions[0];
        if (selectedOption) {
          if (bundleVariantImage && selectedOption.dataset.variantImage) {
            bundleVariantImage.src = selectedOption.dataset.variantImage;
            bundleVariantImage.alt = selectedOption.dataset.variantImageAlt || '';
          }
          if (bundleVariantTitle) {
            bundleVariantTitle.textContent = selectedOption.textContent.trim();
          }
        }
        popupStatus.textContent = '';
      });
    }

    /* ---- Close buttons (X + overlay) ---- */
    closeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        closePopup();
      });
    });

    /* ---- Outside dropdown click closes the size menu ---- */
    document.addEventListener('click', function (event) {
      if (currentSizeDropdown && !currentSizeDropdown.contains(event.target)) {
        closeSizeDropdown();
      }
    });

    /* ---- Escape: close size dropdown first, then the popup ---- */
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        if (
          currentSizeDropdown &&
          currentSizeDropdown.classList.contains('is-open')
        ) {
          closeSizeDropdown();
          return;
        }
        if (popup.classList.contains('is-active')) {
          closePopup();
        }
      }
    });

    /* ==========================================================
       THEME EDITOR SUPPORT — scroll the block into view when it
       is selected in the theme editor sidebar.
       ========================================================== */
    document.addEventListener('shopify:block:select', function (event) {
      const sectionElement = event.target.closest('#{{ section_id }}');
      if (!sectionElement) {
        return;
      }
      const block = event.target.closest('.shoppable-grid-item');
      if (block) {
        block.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        });
      }
    });
  })();
</script>

