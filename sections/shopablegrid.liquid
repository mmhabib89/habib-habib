{% comment %}
  ============================================================================
  SHOPPABLE IMAGE GRID
  ----------------------------------------------------------------------------
  Shopify OS 2.0 section: a responsive image grid with "hotspot" buttons.
  Clicking a hotspot opens a product popup that lets the customer choose
  color / size / normal options and add the product to the cart via
  Shopify's AJAX cart endpoint.

  STRUCTURE
  ---------
  1. Grid ................. image tiles; each block = one image + one hotspot
  2. Product popup ........ dialog with image, price, description, variant
                             options, add-to-cart, and "view product" link
  3. Theme editor support . blocks scroll into view when selected

  BEHAVIOR NOTES
  --------------
  - Variant options are typed (color / size / normal) and rendered as
    buttons, or as a custom dropdown for Size.
  - When the selected option combo is "Black + Medium" AND a bundle product
    is configured, that bundle variant is auto-added to the cart too.
  - Colors are mapped to a hex swatch via getColorCode() (see script).
  ============================================================================
{% endcomment %}

{%- liquid
  # Unique element id per section instance. All scoped CSS rules and the
  # script at the bottom target this id so multiple instances never clash.
  assign section_id = 'ShoppableImageGrid-' | append: section.id

  # Resolve the optional "Automatic bundle product" to a concrete variant id.
  # When the customer picks Black + Medium (see shouldAddBundle in JS) this
  # variant is added to the cart as a free/first bundle item.
  assign bundle_product = section.settings.bundle_product
  if bundle_product != blank
    assign bundle_variant = bundle_product.selected_or_first_available_variant
    if bundle_variant != blank and bundle_variant.available
      assign bundle_variant_id = bundle_variant.id
    else
      assign bundle_variant_id = 0
    endif
  else
    # No bundle configured -> pass 0 so the JS never appends a bundle item.
    assign bundle_variant_id = 0
  endif
-%}

<section
  id="{{ section_id }}"
  class="shoppable-grid-section"
  style="
    --sg-background: {{ section.settings.background_color }};
    --sg-heading-color: {{ section.settings.heading_color }};
    --sg-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sg-heading-size-tablet: {{ section.settings.heading_size_tablet }}px;
    --sg-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sg-columns-desktop: {{ section.settings.columns_desktop }};
    --sg-columns-tablet: {{ section.settings.columns_tablet }};
    --sg-columns-mobile: {{ section.settings.columns_mobile }};
    --sg-gap-desktop: {{ section.settings.gap_desktop }}px;
    --sg-gap-tablet: {{ section.settings.gap_tablet }}px;
    --sg-gap-mobile: {{ section.settings.gap_mobile }}px;
    --sg-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
    --sg-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
    --sg-margin-top-tablet: {{ section.settings.margin_top_tablet }}px;
    --sg-margin-bottom-tablet: {{ section.settings.margin_bottom_tablet }}px;
    --sg-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --sg-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
    --sg-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --sg-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --sg-padding-top-tablet: {{ section.settings.padding_top_tablet }}px;
    --sg-padding-bottom-tablet: {{ section.settings.padding_bottom_tablet }}px;
    --sg-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --sg-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sg-container-width: {{ section.settings.container_width }}px;
    --sg-image-radius: {{ section.settings.image_radius }}px;
  "
  data-currency="{{ shop.currency }}"
  data-cart-error-message="{{ 'sections.cart.cart_error' | t | escape }}"
>

  <div class="shoppable-grid-container">

    {% comment %}
      Optional section heading, rendered above the grid.
    {% endcomment %}
    {% if section.settings.heading != blank %}
      <div class="shoppable-grid-header">
        <h2 class="shoppable-grid-heading">
          {{ section.settings.heading | escape }}
        </h2>
      </div>
    {% endif %}

    {% comment %}
      Grid of image tiles. One tile per block.
      Each tile = image (or placeholder) + optional hotspot button.
    {% endcomment %}
    <div class="shoppable-grid">
      {% for block in section.blocks %}

        {% comment %}
          Resolve the tile image: block's own image wins, otherwise the
          block's product featured image, otherwise nothing (placeholder).
        {% endcomment %}
        {% assign block_product = block.settings.product %}
        {% if block.settings.image != blank %}
          {% assign block_image = block.settings.image %}
        {% elsif block_product != blank and block_product.featured_image != blank %}
          {% assign block_image = block_product.featured_image %}
        {% else %}
          {% assign block_image = blank %}
        {% endif %}

        <div
          class="shoppable-grid-item"
          {{ block.shopify_attributes }}
        >
          <div
            class="
              shoppable-grid-media
              shoppable-grid-media--{{ section.settings.image_ratio }}
            "
            style="
              --hotspot-x: {{ block.settings.hotspot_x }}%;
              --hotspot-y: {{ block.settings.hotspot_y }}%;
              --hotspot-size: {{ block.settings.hotspot_size }}px;
              --hotspot-background: {{ block.settings.hotspot_color }};
              --hotspot-icon-color: {{ block.settings.hotspot_icon_color }};
              --hotspot-border-color: {{ block.settings.hotspot_border_color }};
              --hotspot-border-width: {{ block.settings.hotspot_border_width }}px;
              --hotspot-shadow-opacity: {{ block.settings.hotspot_shadow_opacity | divided_by: 100.0 }};
              --hotspot-hover-scale: {{ block.settings.hotspot_hover_scale | divided_by: 100.0 }};
            "
          >

            {% comment %}
              IMAGE — lazy-loaded product/uploaded image, or a placeholder.
            {% endcomment %}
            {% if block_image != blank %}
              {{
                block_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1500, 1800',
                  sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                  class: 'shoppable-grid-image',
                  alt: block_image.alt
                | default: block_product.title
              }}
            {% else %}
              <div class="shoppable-grid-placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}

            {% comment %}
              HOTSPOT — the click-to-open target. Product data is serialized
              onto data-* attributes so the popup script can read it without
              extra requests. Compare price / image are only emitted when the
              product actually has them, keeping the DOM lean.
            {% endcomment %}
            {% if block_product != blank and block.settings.enable_hotspot %}
              {%- capture product_variants_json -%}
                {{ block_product.variants | json }}
              {%- endcapture -%}
              {%- capture product_options_json -%}
                {{ block_product.options_with_values | json }}
              {%- endcapture -%}
              <button
                type="button"
                class="shoppable-hotspot"
                aria-label="View {{ block_product.title | escape }}"
                aria-expanded="false"
                data-product-id="{{ block_product.id }}"
                data-product-url="{{ block_product.url }}"
                data-product-title="{{ block_product.title | escape }}"
                data-product-price="{{ block_product.price | money_with_currency | escape }}"
                data-product-compare-price="{% if block_product.compare_at_price > block_product.price %}{{ block_product.compare_at_price | money_with_currency | escape }}{% endif %}"
                data-product-image="{% if block_product.featured_image != blank %}{{ block_product.featured_image | image_url: width: 1000 }}{% endif %}"
                data-product-description="{{ block_product.description | escape }}"
                data-product-variants="{{ product_variants_json | escape }}"
                data-product-options="{{ product_options_json | escape }}"
              >
                <span class="shoppable-hotspot-icon">+</span>
              </button>
            {% endif %}

          </div>
        </div>

      {% endfor %}
    </div>

  </div>

  {% comment %}
    ==========================================================================
    PRODUCT POPUP — modal dialog opened by clicking a hotspot
    ==========================================================================
    Single shared instance per section; content is filled in by the script.
    The card is role="dialog" + aria-modal and focus moves to the close
    button on open (see openPopup in the script).
  {% endcomment %}
  <div
    class="shoppable-product-popup"
    aria-hidden="true"
    data-shoppable-popup
  >
    <div
      class="shoppable-product-popup-overlay"
      data-popup-close
    ></div>
    <div
      class="shoppable-product-popup-card"
      role="dialog"
      aria-modal="true"
      aria-label="Product details"
    >
      <!-- CLOSE BUTTON — also triggers on overlay click and Escape -->
      <button
        type="button"
        class="shoppable-product-popup-close"
        aria-label="Close"
        data-popup-close
      >
        <span aria-hidden="true">×</span>
      </button>

      <div class="shoppable-product-popup-content">

        {% comment %}
          TOP AREA — image + title + price + description
        {% endcomment %}
        <div class="shoppable-product-popup-top">
          <!-- PRODUCT IMAGE -->
          <div class="shoppable-product-popup-image-wrap">
            <img
              alt=""
              width="1000"
              height="1000"
              class="shoppable-product-popup-image"
              data-popup-image
            >
          </div>
          <!-- PRODUCT INFORMATION -->
          <div class="shoppable-product-popup-info">
            <h3
              class="shoppable-product-popup-title"
              data-popup-title
            ></h3>
            <div class="shoppable-product-popup-price">
              <span
                class="shoppable-product-popup-current-price"
                data-popup-price
              ></span>
              <span
                class="shoppable-product-popup-compare-price"
                data-popup-compare
              ></span>
            </div>
            <div
              class="shoppable-product-popup-description"
              data-popup-description
            ></div>
          </div>
        </div>

        {% comment %}
          BOTTOM AREA — variant options + add-to-cart + view product
        {% endcomment %}
        <div class="shoppable-product-popup-bottom">
          <div
            class="shoppable-product-popup-variants"
            data-popup-variants
          ></div>
          {% if bundle_product != blank %}
            {% assign bundle_variant_image = bundle_variant.featured_image | default: bundle_product.featured_image %}
            <div class="shoppable-bundle-variant" data-bundle-variant-picker hidden>
              <div class="shoppable-bundle-variant-header">
                <div class="shoppable-bundle-variant-image">
                  {% if bundle_variant_image != blank %}
                    <img
                      src="{{ bundle_variant_image | image_url: width: 240 }}"
                      alt="{{ bundle_product.title | escape }}"
                      width="120"
                      height="144"
                      loading="lazy"
                      data-bundle-variant-image
                    >
                  {% endif %}
                </div>
                <div class="shoppable-bundle-variant-copy">
                  <p class="shoppable-bundle-variant-congratulations">Congratulations!</p>
                  <h4 class="shoppable-bundle-variant-title">Choose your free {{ bundle_product.title | escape }}</h4>
                  <p class="shoppable-bundle-variant-selected" data-bundle-variant-title>{{ bundle_variant.title | escape }}</p>
                  <p class="shoppable-bundle-variant-description">Select your preferred option below.</p>
                </div>
              </div>
              {% if bundle_product.variants_count > 1 %}
                <div class="shoppable-bundle-variant-field">
                  <label class="shoppable-variant-label" for="ShoppableBundleVariant-{{ section.id }}">
                    Gift variant
                  </label>
                  <select
                    id="ShoppableBundleVariant-{{ section.id }}"
                    class="shoppable-bundle-variant-select"
                    data-bundle-variant
                    {% unless bundle_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {% for gift_variant in bundle_product.variants %}
                      {% if gift_variant.available %}
                        {% assign gift_variant_image = gift_variant.featured_image | default: bundle_product.featured_image %}
                        <option
                          value="{{ gift_variant.id }}"
                          data-variant-image="{% if gift_variant_image != blank %}{{ gift_variant_image | image_url: width: 240 }}{% endif %}"
                          data-variant-image-alt="{{ bundle_product.title | append: ' ' | append: gift_variant.title | escape }}"
                          {% if gift_variant.id == bundle_variant.id %}
                            selected
                          {% endif %}
                        >
                          {{- gift_variant.title | escape -}}
                        </option>
                      {% endif %}
                    {% endfor %}
                  </select>
                </div>
              {% else %}
                <input type="hidden" data-bundle-variant value="{% if bundle_variant.available %}{{ bundle_variant.id }}{% endif %}">
              {% endif %}
            </div>
          {% endif %}
          <!-- ADD TO CART — stays disabled until every option is selected -->
          <button
            type="button"
            class="shoppable-product-popup-add"
            data-popup-add-to-cart
            disabled
          >
            <span data-add-text> CHOOSE OPTIONS </span>
            <span
              class="shoppable-product-popup-add-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </button>
          <p class="shoppable-product-popup-status" data-popup-status role="status" aria-live="polite"></p>
          <!-- VIEW PRODUCT -->
          <a
            href="#"
            class="shoppable-product-popup-view"
            data-popup-link
          >
            {{ section.settings.view_product_text | escape }}
          </a>
        </div>

      </div>

    </div>
  </div>

</section>


<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  /* ==========================================================
     SECTION
     ========================================================== */
  #{{ section_id }} {
    width: 100%;
    background: var(--sg-background);
    margin-top: var(--sg-margin-top-desktop);
    margin-bottom: var(--sg-margin-bottom-desktop);
    padding-top: var(--sg-padding-top-desktop);
    padding-bottom: var(--sg-padding-bottom-desktop);
    box-sizing: border-box;
  }

  /* ==========================================================
     CONTAINER
     ========================================================== */
  #{{ section_id }} .shoppable-grid-container {
    width: 100%;
    max-width: var(--sg-container-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  /* ==========================================================
     HEADING
     ========================================================== */
  #{{ section_id }} .shoppable-grid-header {
    width: 100%;
    margin-bottom: 30px;
  }

  #{{ section_id }} .shoppable-grid-heading {
    margin: 0;
    color: var(--sg-heading-color);
    font-family: "{{ section.settings.heading_font.family | escape }}", {{ section.settings.heading_font.fallback_families | escape }};
    font-size: var(--sg-heading-size-desktop);
    line-height: 1.2;
    font-weight: 400;
  }

  /* ==========================================================
     GRID
     ========================================================== */
  #{{ section_id }} .shoppable-grid {
    display: grid;
    grid-template-columns: repeat(var(--sg-columns-desktop), minmax(0, 1fr));
    gap: var(--sg-gap-desktop);
    width: 100%;
  }

  #{{ section_id }} .shoppable-grid-item {
    min-width: 0;
    width: 100%;
  }

  /* ==========================================================
     IMAGE
     ========================================================== */
  #{{ section_id }} .shoppable-grid-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f4f4f4;
    border-radius: var(--sg-image-radius);
  }

  /* Fixed aspect ratios — the selected ratio is appended to the class name
     (e.g. shoppable-grid-media--square) from the section settings. */
  #{{ section_id }} .shoppable-grid-media--square {
    aspect-ratio: 1 / 1;
  }

  #{{ section_id }} .shoppable-grid-media--portrait {
    aspect-ratio: 4 / 5;
  }

  #{{ section_id }} .shoppable-grid-media--landscape {
    aspect-ratio: 4 / 3;
  }

  #{{ section_id }} .shoppable-grid-media--wide {
    aspect-ratio: 16 / 10;
  }

  #{{ section_id }} .shoppable-grid-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ==========================================================
     PLACEHOLDER — shown when a block has no image at all
     ========================================================== */
  #{{ section_id }} .shoppable-grid-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }

  #{{ section_id }} .shoppable-grid-placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  /* ==========================================================
     HOTSPOT — circular "+" button positioned over the image.
     Position/size/colors all come from per-block custom properties.
     ========================================================== */
  #{{ section_id }} .shoppable-hotspot {
    position: absolute;
    left: var(--hotspot-x);
    top: var(--hotspot-y);

    width: var(--hotspot-size);
    height: var(--hotspot-size);

    display: flex;
    align-items: center;
    justify-content: center;

    /* Center the circle exactly on the x/y coordinates */
    transform: translate(-50%, -50%);

    padding: 0;
    margin: 0;

    border: var(--hotspot-border-width) solid var(--hotspot-border-color);
    border-radius: 50%;

    background: var(--hotspot-background);
    color: var(--hotspot-icon-color);

    cursor: pointer;
    z-index: 10;

    appearance: none;
    -webkit-appearance: none;
    box-sizing: border-box;

    box-shadow: 0 2px 10px rgba(0, 0, 0, var(--hotspot-shadow-opacity));

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  #{{ section_id }} .shoppable-hotspot:hover {
    transform: translate(-50%, -50%) scale(var(--hotspot-hover-scale));
    box-shadow: 0 5px 18px
      rgba(0, 0, 0, calc(var(--hotspot-shadow-opacity) + 0.1));
  }

  #{{ section_id }} .shoppable-hotspot:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #{{ section_id }} .shoppable-hotspot-icon {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(var(--hotspot-size) * 0.55);
    line-height: 1;
    font-weight: 300;
    transform: translateY(-1px); /* optical centering of the + glyph */
    pointer-events: none;
  }

  /* ==========================================================
     POPUP OVERLAY
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
    box-sizing: border-box;
  }

  /* .is-active is added by the script to reveal the popup. */
  #{{ section_id }} .shoppable-product-popup.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #{{ section_id }} .shoppable-product-popup-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    cursor: pointer;
  }

  /* ==========================================================
     POPUP CARD
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 560px;
    max-height: calc(100vh - 40px);
    background: #ffffff;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.24);
    transform: translateY(12px) scale(0.985);
    transition: transform 0.25s ease;
    box-sizing: border-box;
    scrollbar-width: thin;
  }

  /* Slight scale-up "pop" when the popup becomes active. */
  #{{ section_id }} .shoppable-product-popup.is-active .shoppable-product-popup-card {
    transform: translateY(0) scale(1);
  }

  /* ==========================================================
     CLOSE BUTTON
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    line-height: 1;
    cursor: pointer;
    z-index: 20;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }

  #{{ section_id }} .shoppable-product-popup-close:hover {
    background: transparent;
    box-shadow: none;
    transform: rotate(90deg);
  }

  #{{ section_id }} .shoppable-product-popup-close:focus-visible {
    background: transparent;
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  /* ==========================================================
     POPUP CONTENT
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-content {
    width: 100%;
    padding: 15px;
    box-sizing: border-box;
  }

  /* ==========================================================
     TOP PRODUCT AREA — 40% image / 60% info two-column grid
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-top {
    display: grid;
    grid-template-columns:
      minmax(0, 40%)
      minmax(0, 60%);
    width: 100%;
    align-items: start;
  }

  /* ==========================================================
     PRODUCT IMAGE
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    overflow: hidden;
    box-sizing: border-box;
  }

  #{{ section_id }} .shoppable-product-popup-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  #{{ section_id }}
    .shoppable-product-popup-image-wrap:hover
    .shoppable-product-popup-image {
    transform: scale(1.015);
  }

  /* ==========================================================
     PRODUCT INFORMATION
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 15px 15px 10px;
  }

  /* ==========================================================
     TITLE
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-title {
    margin: 0 0 13px;
    padding-right: 25px; /* keeps long titles clear of the close button */
    color: #000;
    font-family: "{{ section.settings.heading_font.family | escape }}", {{ section.settings.heading_font.fallback_families | escape }};
    font-size: 25px;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  /* ==========================================================
     PRICE
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 20px;
  }

  #{{ section_id }} .shoppable-product-popup-current-price {
    color: #000;
    font-size: 16px;
    line-height: 1.3;
  }

  #{{ section_id }} .shoppable-product-popup-compare-price {
    color: #8a8a8a;
    font-size: 14px;
    line-height: 1.3;
    text-decoration: line-through;
  }

  /* ==========================================================
     DESCRIPTION — scrollable region for long product copy
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-description {
    max-height: 145px;
    overflow-y: auto;
    margin: 0;
    color: #555555;
    font-size: 14px;
    line-height: 1.65;
    scrollbar-width: thin;
  }

  #{{ section_id }} .shoppable-product-popup-description p {
    margin: 0 0 9px;
  }

  #{{ section_id }} .shoppable-product-popup-description p:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .shoppable-product-popup-description ul,
  #{{ section_id }} .shoppable-product-popup-description ol {
    margin: 0 0 10px;
    padding-left: 20px;
  }

  /* ==========================================================
     BOTTOM OPTIONS SECTION
     ========================================================== */
  #{{ section_id }} .shoppable-product-popup-bottom {
    width: 100%;
